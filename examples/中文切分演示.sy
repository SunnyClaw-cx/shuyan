# 中文切分演示 —— 枢言词法层的核心能力
# 运行：sy 词法 examples/中文切分演示.sy
# 目的：展示中文粘连切分的**正确**与**边界**行为。

输出("=== 一、关键字紧贴标识符（自动切分）===")
定义年龄 = 30
定义城市 = "郑州"
输出("年龄：" + 转文本(年龄) + "，城市：" + 城市)

输出("")
输出("=== 二、含关键字的普通词（不得误切）===")
定义 数据中台 = "某平台"
定义 期中成绩 = 95
定义 规则 = "先到先得"
定义 无线网络 = "已连接"
输出(数据中台)
输出("期中成绩：" + 转文本(期中成绩))
输出("规则：" + 规则)
输出(无线网络)

输出("")
输出("=== 三、中文数词字面量 ===")
定义 甲 = 三
定义 乙 = 一百二十
定义 丙 = 十五
定义 丁 = 十亿
定义 戊 = 3万
输出(`三 = {甲}，一百二十 = {乙}，十五 = {丙}`)
输出(`十亿 = {丁}，3万 = {戊}`)

输出("")
输出("=== 四、中文运算符词 ===")
定义 长 = 6
定义 宽 = 7
输出(`面积 = {长 乘以 宽}`)
输出(`2 的 10 次方 = {次方(2, 10)}`)
输出("说明：`2 的 10 次方` 这种写法**已被规范否决**——")
输出(" 中文的「的」字太常用（我的名字、系统的状态），")
输出(" 定为运算符会制造大量歧义。请改用 次方(底, 指数) 或 ^。")

输出("")
输出("=== 五、混合标识符（下划线界定）===")
定义 订单_ID = "ORD-2026-001"
定义 user_编号 = 1001
输出(订单_ID)
输出("用户编号：" + 转文本(user_编号))

输出("")
输出("=== 六、反引号逃生舱（关键字当标识符）===")
定义 `定义` = "这是一个名叫「定义」的变量"
输出(`定义`)
