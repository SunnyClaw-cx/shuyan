// 枢言示例：结构体与枚举（SPEC §3.9）
//
// 展示两件事：
//   ① 用 `类型` + `{}` 定义结构体与枚举 —— 零新增关键字，不引入任何词法歧义
//   ② 构造复用调用语法、成员复用 `.` —— 与既有语法完全一致
//
// 运行：sy 运行 examples/结构体与枚举.sy

// ============================================================ 一、结构体

// 含 `:` 的条目 ⇒ 结构体。字段可读写，打印按声明顺序。
类型 点 = { 横: 整数, 纵: 整数 }

定义 起点 = 点(横 是 0, 纵 是 0)
定义 终点 = 点(纵 是 4, 横 是 3)  # 具名字段，顺序无关
输出("起点：" + 转文本(起点))
输出("终点：" + 转文本(终点))

// 字段访问与赋值
终点.纵 = 5
输出("终点改后：" + 转文本(终点))

// 结构体可以嵌套
类型 线段 = { 起点: 点, 终点: 点 }
定义 一条线 = 线段(起点 是 点(横 是 1, 纵 是 1),
终点 是 点(横 是 4, 纵 是 5))
输出("线段的起点横坐标：" + 转文本(一条线.起点.横))

// 结构体按字段值比较相等
定义 甲点 = 点(横 是 2, 纵 是 2)
定义 乙点 = 点(纵 是 2, 横 是 2)
输出("两点相等吗：" + 转文本(甲点 等于 乙点))

// ============================================================ 二、枚举

// 全部条目都不含 `:` ⇒ 枚举。成员由类型定义固定，不可修改。
类型 星期 = { 一, 二, 三, 四, 五, 六, 日 }

定义 今天 = 星期.三
输出("今天：" + 转文本(今天))
输出("序号：" + 转文本(今天.序号))  # 序号从 1 起
输出("名称：" + 转文本(今天.名称))

若 今天 等于 星期.三 则
    输出("今天周三，安排例会")
结束

// 中文数词作成员名：按源码原文匹配（`一` 不会与 `1` 混淆）
类型 优先级 = { 一, 二, 三 }
输出("最高优先级序号：" + 转文本(优先级.一.序号))  # 1

// 需要整体保留的词，用反引号声明（`进行中` 否则会被切成 `进行` + `中`）
类型 工单状态 = { 待受理, `处理中`, 已完成, 已关闭 }
定义 工单 = 工单状态.`处理中`
输出("工单：" + 转文本(工单) + "（第 " + 转文本(工单.序号) + " 个状态）")

// ============================================================ 三、配合使用

// 结构体字段用枚举类型 —— 这是最实用的组合
类型 任务 = { 标题: 文本, 状态: 工单状态, 优先级: 优先级 }

定义 全部任务 = [
任务(标题 是 "整理库存", 状态 是 工单状态.已完成,
优先级 是 优先级.一),
任务(标题 是 "核对账单", 状态 是 工单状态.`处理中`,
优先级 是 优先级.二),
任务(标题 是 "归档单据", 状态 是 工单状态.待受理,
优先级 是 优先级.三)
]

输出("")
输出("任务清单：")
遍历 全部任务 中的每个 某任务
    如果 某任务.状态 等于 工单状态.已完成 则
        输出(" ✓ " + 某任务.标题)
    否则
        输出(" · " + 某任务.标题
        + "（" + 某任务.状态.名称 + "，"
        + "优先级 " + 某任务.优先级.名称 + "）")
    结束
结束

// 统计
定义 已完成数 = 0
遍历 全部任务 中的每个 某任务
    如果 某任务.状态 等于 工单状态.已完成 则
        已完成数 = 已完成数 + 1
    结束
结束
输出("")
输出("已完成 " + 转文本(已完成数) + " / " + 转文本(长度(全部任务)) + " 项")
