# 斐波那契数列 —— 递归、列表、文本拼接
# 运行：sy 运行 examples/斐波那契.sy

请 斐波那契(n)
    如果 n <= 1 则
        返回 n
    结束
    返回 斐波那契(n - 1) + 斐波那契(n - 2)
结束

定义 数列 = []
重复 甲 从 0 到 15
    入列(数列, 斐波那契(甲))
结束

输出("斐波那契数列（前 16 项）：")
输出(" " + 连接(数列, ", "))

# 迭代版本的对照：递推比递归快得多
请 递推斐波那契(n)
    定义 甲 = 0
    定义 乙 = 1
    重复 i 从 1 到 n
        定义 临时 = 甲 + 乙
        甲 是 乙
        乙 是 临时
    结束
    返回 甲
结束

输出(`第 40 项（递推法）：{递推斐波那契(40)}`)
