请 财务_会计凭证判定(某记录)
    定义 规则们 = 财务_会计凭证规则表()
    定义 判定表 = [
    [规则们[0], 某记录.金额 > 1 * 1000],
    [规则们[1], 某记录.金额 > 2 * 1000],
    [规则们[2], 某记录.金额 > 3 * 1000],
    [规则们[3], 某记录.金额 > 4 * 1000],
    [规则们[4], 某记录.金额 > 5 * 1000],
