// ------------------------------------------------------------ 财务报表

类型 财务报表 = {
    编号: 文本,
    名称: 文本,
    状态: 本域状态,
    主责人: 文本,
    建立日期: 文本,
    金额: 整数,
    税额: 整数,
    净额: 整数,
}

请 财务_造状态(名)
    如果 名 是 "草稿" 则
        返回 本域状态.草稿
    结束
    如果 名 是 "已提交" 则
        返回 本域状态.已提交
    结束
    如果 名 是 "已审批" 则
        返回 本域状态.已审批
    结束
    如果 名 是 "已执行" 则
        返回 本域状态.已执行
    结束
    如果 名 是 "已完成" 则
        返回 本域状态.已完成
    结束
    返回 本域状态.已作废
结束


请 财务_造会计凭证(编号, 名称, 状态, 主责人, 建立日期, 金额, 税额, 净额)
    返回 会计凭证(编号 是 编号, 名称 是 名称, 状态 是 状态,
    主责人 是 主责人, 建立日期 是 建立日期,
    金额 是 金额, 税额 是 税额, 净额 是 净额)
结束

请 财务_造总账余额(编号, 名称, 状态, 主责人, 建立日期, 金额, 税额, 净额)
    返回 总账余额(编号 是 编号, 名称 是 名称, 状态 是 状态,
