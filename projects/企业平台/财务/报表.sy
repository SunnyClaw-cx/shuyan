// ============================================================ 财务域 · 报表
//
// 报表层：只做**呈现**，不含业务判定。
// 表格一律经 `框架/报表` 渲染 —— 列宽与对齐规则只有一份。

引入 "框架/报表"
引入 "财务/模型"
引入 "财务/服务"
引入 { 右对齐, 左对齐, 账龄名 } 从 "框架/基础"
引入 { 数值列, 文本列, 造表格, 金额列 } 从 "框架/报表"
引入 { 财务_会计凭证净额, 财务_会计凭证净额合计, 财务_会计凭证税额合计 } 从 "财务/服务"
引入 { 财务_会计凭证金额合计, 财务_固定资产到期日, 财务_固定资产按桶统计 } 从 "财务/服务"
引入 { 财务_固定资产账龄桶, 财务_固定资产逾期天数, 财务_应付账款到期日 } 从 "财务/服务"
引入 { 财务_应付账款按桶统计, 财务_应付账款账龄桶, 财务_应付账款逾期天数 } 从 "财务/服务"
引入 { 财务_应收账款到期日, 财务_应收账款按桶统计, 财务_应收账款账龄桶 } 从 "财务/服务"
引入 { 财务_应收账款逾期天数, 财务_总账余额净额, 财务_总账余额净额合计 } 从 "财务/服务"
引入 { 财务_总账余额税额合计, 财务_总账余额金额合计, 财务_成本核算净额 } 从 "财务/服务"
引入 { 财务_成本核算净额合计, 财务_成本核算税额合计, 财务_成本核算金额合计 } 从 "财务/服务"
引入 { 财务_折旧计提净额, 财务_折旧计提净额合计, 财务_折旧计提税额合计 } 从 "财务/服务"
引入 { 财务_折旧计提金额合计, 财务_财务报表净额, 财务_财务报表净额合计 } 从 "财务/服务"
引入 { 财务_财务报表税额合计, 财务_财务报表金额合计, 财务_资金计划净额 } 从 "财务/服务"
引入 { 财务_资金计划净额合计, 财务_资金计划税额合计, 财务_资金计划金额合计 } 从 "财务/服务"
引入 { 财务_银行对账净额, 财务_银行对账净额合计, 财务_银行对账税额合计 } 从 "财务/服务"
引入 { 财务_银行对账金额合计, 财务_预算控制净额, 财务_预算控制净额合计 } 从 "财务/服务"
引入 { 财务_预算控制税额合计, 财务_预算控制金额合计 } 从 "财务/服务"


// ------------------------------------------------------------ 会计凭证 报表

请 财务_会计凭证明细表(全部结果)
    定义 列们 = [
    文本列("编号", 14),
    文本列("名称", 18),
    文本列("状态", 8),
    文本列("主责人", 10),
    文本列("建立日期", 12)
    ]
    定义 行们 = []
    遍历 全部结果 中的每个 某记录
        入列(行们, [某记录.编号, 某记录.名称, 某记录.状态.名称,
        某记录.主责人, 某记录.建立日期])
    结束
    返回 造表格("会计凭证明细", 列们, 行们)
结束

请 财务_会计凭证状态汇总(全部结果)
    定义 分布 = {}
    遍历 全部结果 中的每个 某记录
        定义 键 = 某记录.状态.名称
        如果 非 有键(分布, 键) 则
            分布[键] = 0
        结束
        分布[键] = 分布[键] + 1
    结束
    定义 列们 = [文本列("状态", 12), 数值列("条数", 8)]
    定义 行们 = []
    遍历 取键(分布) 中的每个 某键
        入列(行们, [某键, 分布[某键]])
    结束
    入列(行们, ["合计", 长度(全部结果)])
    返回 造表格("会计凭证状态分布", 列们, 行们)
结束

请 财务_会计凭证看板行(全部结果)
    返回 左对齐("会计凭证", 12) + 右对齐(长度(全部结果), 6) + " 条"
    结束


请 财务_会计凭证金额表(全部结果)
    定义 列们 = [
    文本列("名称", 18),
    金额列("金额", 16),
    金额列("税额", 14),
    金额列("净额", 16)
    ]
    定义 行们 = []
    遍历 全部结果 中的每个 某记录
        入列(行们, [某记录.名称, 某记录.金额, 某记录.税额,
        财务_会计凭证净额(某记录)])
    结束
    入列(行们, ["合计", 财务_会计凭证金额合计(全部结果),
    财务_会计凭证税额合计(全部结果), 财务_会计凭证净额合计(全部结果)])
    返回 造表格("会计凭证金额汇总", 列们, 行们)
结束


