    造规则("销售-报价单-009", "报价单规则9", "拦截", "条件9", "结论9"),
    造规则("销售-报价单-010", "报价单规则10", "警告", "条件10", "结论10"),
    造规则("销售-报价单-011", "报价单规则11", "提示", "条件11", "结论11"),
    造规则("销售-报价单-012", "报价单规则12", "拦截", "条件12", "结论12"),
    造规则("销售-报价单-013", "报价单规则13", "警告", "条件13", "结论13"),
    造规则("销售-报价单-014", "报价单规则14", "提示", "条件14", "结论14"),
