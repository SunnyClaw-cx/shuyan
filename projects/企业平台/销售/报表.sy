// ============================================================ 销售域 · 报表
//
// 报表层：只做**呈现**，不含业务判定。
// 表格一律经 `框架/报表` 渲染 —— 列宽与对齐规则只有一份。

引入 "框架/报表"
引入 "销售/模型"
引入 "销售/服务"
引入 { 右对齐, 左对齐, 账龄名 } 从 "框架/基础"
引入 { 数值列, 文本列, 造表格, 金额列 } 从 "框架/报表"
引入 { 销售_客户信用净额, 销售_客户信用净额合计, 销售_客户信用税额合计 } 从 "销售/服务"
引入 { 销售_客户信用金额合计, 销售_报价单净额, 销售_报价单净额合计 } 从 "销售/服务"
引入 { 销售_报价单税额合计, 销售_报价单金额合计, 销售_渠道价格净额 } 从 "销售/服务"
引入 { 销售_渠道价格净额合计, 销售_渠道价格税额合计, 销售_渠道价格金额合计 } 从 "销售/服务"
引入 { 销售_销售发货数量合计, 销售_销售发货金额, 销售_销售发货金额合计 } 从 "销售/服务"
引入 { 销售_销售台账净额, 销售_销售台账净额合计, 销售_销售台账税额合计 } 从 "销售/服务"
引入 { 销售_销售台账金额合计, 销售_销售合同到期日, 销售_销售合同按桶统计 } 从 "销售/服务"
引入 { 销售_销售合同账龄桶, 销售_销售合同逾期天数, 销售_销售开票净额 } 从 "销售/服务"
引入 { 销售_销售开票净额合计, 销售_销售开票税额合计, 销售_销售开票金额合计 } 从 "销售/服务"
引入 { 销售_销售提成净额, 销售_销售提成净额合计, 销售_销售提成税额合计 } 从 "销售/服务"
引入 { 销售_销售提成金额合计, 销售_销售收款净额, 销售_销售收款净额合计 } 从 "销售/服务"
引入 { 销售_销售收款税额合计, 销售_销售收款金额合计, 销售_销售目标净额 } 从 "销售/服务"
引入 { 销售_销售目标净额合计, 销售_销售目标税额合计, 销售_销售目标金额合计 } 从 "销售/服务"
引入 { 销售_销售退货数量合计, 销售_销售退货金额, 销售_销售退货金额合计 } 从 "销售/服务"


// ------------------------------------------------------------ 报价单 报表

请 销售_报价单明细表(全部结果)
    定义 列们 = [
    文本列("编号", 14),
    文本列("名称", 18),
    文本列("状态", 8),
    文本列("主责人", 10),
    文本列("建立日期", 12)
    ]
    定义 行们 = []
    遍历 全部结果 中的每个 某记录
        入列(行们, [某记录.编号, 某记录.名称, 某记录.状态.名称,
        某记录.主责人, 某记录.建立日期])
    结束
    返回 造表格("报价单明细", 列们, 行们)
结束

请 销售_报价单状态汇总(全部结果)
    定义 分布 = {}
    遍历 全部结果 中的每个 某记录
        定义 键 = 某记录.状态.名称
        如果 非 有键(分布, 键) 则
            分布[键] = 0
        结束
        分布[键] = 分布[键] + 1
    结束
    定义 列们 = [文本列("状态", 12), 数值列("条数", 8)]
    定义 行们 = []
    遍历 取键(分布) 中的每个 某键
        入列(行们, [某键, 分布[某键]])
    结束
    入列(行们, ["合计", 长度(全部结果)])
    返回 造表格("报价单状态分布", 列们, 行们)
结束

请 销售_报价单看板行(全部结果)
    返回 左对齐("报价单", 12) + 右对齐(长度(全部结果), 6) + " 条"
    结束


请 销售_报价单金额表(全部结果)
    定义 列们 = [
    文本列("名称", 18),
    金额列("金额", 16),
    金额列("税额", 14),
    金额列("净额", 16)
    ]
    定义 行们 = []
    遍历 全部结果 中的每个 某记录
        入列(行们, [某记录.名称, 某记录.金额, 某记录.税额,
        销售_报价单净额(某记录)])
    结束
    入列(行们, ["合计", 销售_报价单金额合计(全部结果),
    销售_报价单税额合计(全部结果), 销售_报价单净额合计(全部结果)])
    返回 造表格("报价单金额汇总", 列们, 行们)
结束


