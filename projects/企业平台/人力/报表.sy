// ============================================================ 人力域 · 报表
//
// 报表层：只做**呈现**，不含业务判定。
// 表格一律经 `框架/报表` 渲染 —— 列宽与对齐规则只有一份。

引入 "框架/报表"
引入 "人力/模型"
引入 "人力/服务"
引入 { 人力_人力成本净额, 人力_人力成本净额合计, 人力_人力成本税额合计 } 从 "人力/服务"
引入 { 人力_人力成本金额合计, 人力_工时统计数量合计, 人力_工时统计金额 } 从 "人力/服务"
引入 { 人力_工时统计金额合计, 人力_社保公积金净额, 人力_社保公积金净额合计 } 从 "人力/服务"
引入 { 人力_社保公积金税额合计, 人力_社保公积金金额合计, 人力_考勤记录到期日 } 从 "人力/服务"
引入 { 人力_考勤记录按桶统计, 人力_考勤记录账龄桶, 人力_考勤记录逾期天数 } 从 "人力/服务"
引入 { 人力_薪资核算净额, 人力_薪资核算净额合计, 人力_薪资核算税额合计 } 从 "人力/服务"
引入 { 人力_薪资核算金额合计 } 从 "人力/服务"
引入 { 右对齐, 左对齐, 账龄名 } 从 "框架/基础"
引入 { 数值列, 文本列, 造表格, 金额列 } 从 "框架/报表"


// ------------------------------------------------------------ 员工档案 报表

请 人力_员工档案明细表(全部结果)
    定义 列们 = [
    文本列("编号", 14),
    文本列("名称", 18),
    文本列("状态", 8),
    文本列("主责人", 10),
    文本列("建立日期", 12)
    ]
    定义 行们 = []
    遍历 全部结果 中的每个 某记录
        入列(行们, [某记录.编号, 某记录.名称, 某记录.状态.名称,
        某记录.主责人, 某记录.建立日期])
    结束
    返回 造表格("员工档案明细", 列们, 行们)
结束

请 人力_员工档案状态汇总(全部结果)
    定义 分布 = {}
    遍历 全部结果 中的每个 某记录
        定义 键 = 某记录.状态.名称
        如果 非 有键(分布, 键) 则
            分布[键] = 0
        结束
        分布[键] = 分布[键] + 1
    结束
    定义 列们 = [文本列("状态", 12), 数值列("条数", 8)]
    定义 行们 = []
    遍历 取键(分布) 中的每个 某键
        入列(行们, [某键, 分布[某键]])
    结束
    入列(行们, ["合计", 长度(全部结果)])
    返回 造表格("员工档案状态分布", 列们, 行们)
结束

请 人力_员工档案看板行(全部结果)
    返回 左对齐("员工档案", 12) + 右对齐(长度(全部结果), 6) + " 条"
    结束


