    文本列("建立日期", 12)
    ]
    定义 行们 = []
    遍历 全部结果 中的每个 某记录
        入列(行们, [某记录.编号, 某记录.名称, 某记录.状态.名称,
        某记录.主责人, 某记录.建立日期])
    结束
    返回 造表格("考勤记录明细", 列们, 行们)
结束

请 人力_考勤记录状态汇总(全部结果)
    定义 分布 = {}
    遍历 全部结果 中的每个 某记录
        定义 键 = 某记录.状态.名称
        如果 非 有键(分布, 键) 则
            分布[键] = 0
        结束
        分布[键] = 分布[键] + 1
    结束
    定义 列们 = [文本列("状态", 12), 数值列("条数", 8)]
    定义 行们 = []
    遍历 取键(分布) 中的每个 某键
        入列(行们, [某键, 分布[某键]])
    结束
    入列(行们, ["合计", 长度(全部结果)])
    返回 造表格("考勤记录状态分布", 列们, 行们)
结束

请 人力_考勤记录看板行(全部结果)
    返回 左对齐("考勤记录", 12) + 右对齐(长度(全部结果), 6) + " 条"
    结束


请 人力_考勤记录账龄表(全部结果, 基准日)
    定义 列们 = [
    文本列("编号", 14),
    文本列("到期日", 12),
    数值列("逾期天数", 10),
    文本列("账龄", 12)
    ]
    定义 行们 = []
    遍历 全部结果 中的每个 某记录
        定义 桶 = 人力_考勤记录账龄桶(某记录, 基准日)
        入列(行们, [某记录.编号, 人力_考勤记录到期日(某记录),
        人力_考勤记录逾期天数(某记录, 基准日), 账龄名(桶)])
    结束
    返回 造表格("考勤记录账龄分析", 列们, 行们)
结束

请 人力_考勤记录桶汇总(全部结果, 基准日)
    定义 分布 = 人力_考勤记录按桶统计(全部结果, 基准日)
    定义 列们 = [文本列("账龄", 12), 数值列("条数", 8)]
    定义 行们 = []
    遍历 取键(分布) 中的每个 某键
        入列(行们, [某键, 分布[某键]])
    结束
    返回 造表格("考勤记录账龄分布", 列们, 行们)
结束


