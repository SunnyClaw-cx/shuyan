请 主数据_物料分类状态汇总(全部结果)
    定义 分布 = {}
    遍历 全部结果 中的每个 某记录
        定义 键 = 某记录.状态.名称
        如果 非 有键(分布, 键) 则
            分布[键] = 0
        结束
        分布[键] = 分布[键] + 1
    结束
    定义 列们 = [文本列("状态", 12), 数值列("条数", 8)]
    定义 行们 = []
    遍历 取键(分布) 中的每个 某键
        入列(行们, [某键, 分布[某键]])
    结束
    入列(行们, ["合计", 长度(全部结果)])
