// ============================================================ 主数据域 · 服务
//
// 服务层：**纯函数** —— 只读入参、不改入参、只返回值。
//
// 枢言的赋值是**引用语义**。若服务层随手改入参，调用方持有的对象会被
// 悄悄改掉，跨模块排查极其困难。故这里一律「算出新对象并返回」，
// 状态更新由调用方整体替换。

引入 "主数据/模型"
引入 { 本域状态, 物料, 物料分类, 往来单位, 客户, 供应商, 会计科目, 仓库, 库位 } 从 "主数据/模型"
引入 { 部门, 员工, 计量单位, 税率 } 从 "主数据/模型"
引入 { 合并校验, 要求非空, 要求非负 } 从 "框架/基础"


// ============================================================ 物料

// 校验：返回 [是否通过, 说明]
请 主数据_物料校验(某记录)
    定义 结果表 = [
    要求非空(某记录.编号, "编号"),
    要求非空(某记录.名称, "名称")
    ]
    返回 合并校验(结果表)
结束


请 主数据_物料启用数(全部结果)
    定义 合计 = 0
    遍历 全部结果 中的每个 某记录
        如果 某记录.启用 则
            合计 = 合计 + 1
        结束
    结束
    返回 合计
结束

请 主数据_物料按分类(全部结果, 分类)
    定义 结果 = []
    遍历 全部结果 中的每个 某记录
        如果 某记录.分类 是 分类 则
            入列(结果, 某记录)
        结束
    结束
    返回 结果
结束

请 主数据_物料分类分布(全部结果)
    定义 结果 = {}
    遍历 全部结果 中的每个 某记录
        定义 键 = 某记录.分类
        如果 非 有键(结果, 键) 则
            结果[键] = 0
        结束
        结果[键] = 结果[键] + 1
    结束
    返回 结果
结束

请 主数据_物料启用率(全部结果)
    如果 长度(全部结果) 是 0 则
        返回 0
    结束
    返回 数学.向下取整(主数据_物料启用数(全部结果) * 100 / 长度(全部结果))
结束


// ============================================================ 物料分类

// 校验：返回 [是否通过, 说明]
请 主数据_物料分类校验(某记录)
    定义 结果表 = [
    要求非空(某记录.编号, "编号"),
    要求非空(某记录.名称, "名称")
    ]
    返回 合并校验(结果表)
结束


请 主数据_物料分类层级校验(某记录)
    定义 结果表 = [
    要求非负(某记录.层级, "层级"),
    要求非负(某记录.排序号, "排序号")
    ]
    返回 合并校验(结果表)
结束

// 直接子节点
请 主数据_物料分类子节点(全部结果, 上级编号)
    定义 结果 = []
    遍历 全部结果 中的每个 某记录
        如果 某记录.上级编号 是 上级编号 则
            入列(结果, 某记录)
        结束
    结束
    返回 排序依据(结果, 主数据_物料分类取排序号)
结束

请 主数据_物料分类取排序号(某记录)
    返回 某记录.排序号
结束

// 子树全部节点（广度优先）
请 主数据_物料分类子树(全部结果, 起点编号)
    定义 结果 = []
    定义 待办 = [起点编号]
    当 长度(待办) > 0 成立
        定义 当前 = 待办[0]
        定义 剩余 = 切片(待办, 1)
        待办 = 剩余
        定义 孩子们 = 主数据_物料分类子节点(全部结果, 当前)
        遍历 孩子们 中的每个 某记录
            入列(结果, 某记录)
            入列(待办, 某记录.编号)
        结束
    结束
    返回 结果
结束

请 主数据_物料分类最大深度(全部结果)
    定义 最大层 = 0
    遍历 全部结果 中的每个 某记录
        如果 某记录.层级 > 最大层 则
            最大层 = 某记录.层级
        结束
    结束
    返回 最大层
结束

// 按层级分组计数
请 主数据_物料分类层级分布(全部结果)
    定义 结果 = {}
    遍历 全部结果 中的每个 某记录
        定义 键 = "第 " + 转文本(某记录.层级) + " 层"
        如果 非 有键(结果, 键) 则
            结果[键] = 0
        结束
        结果[键] = 结果[键] + 1
    结束
    返回 结果
结束


