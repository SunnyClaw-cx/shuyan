// ------------------------------------------------------------ 会计科目 仓储

请 找会计科目(全部结果, 编号)
    遍历 全部结果 中的每个 某记录
        如果 某记录.编号 是 编号 则
            返回 某记录
        结束
    结束
    返回 空
结束

请 存在会计科目(全部结果, 编号)
    返回 非 (找会计科目(全部结果, 编号) 是 空)
结束

请 新增会计科目(全部结果, 某记录)
    定义 结果 = []
    遍历 全部结果 中的每个 某项
        入列(结果, 某项)
    结束
    入列(结果, 某记录)
    返回 结果
结束

请 更新会计科目(全部结果, 编号, 新记录)
    定义 结果 = []
    遍历 全部结果 中的每个 某项
        如果 某项.编号 是 编号 则
            入列(结果, 新记录)
        否则
            入列(结果, 某项)
        结束
    结束
    返回 结果
结束

请 删除会计科目(全部结果, 编号)
    定义 结果 = []
    遍历 全部结果 中的每个 某项
        如果 某项.编号 != 编号 则
            入列(结果, 某项)
        结束
    结束
    返回 结果
结束

请 按状态会计科目(全部结果, 想要状态)
    定义 结果 = []
    遍历 全部结果 中的每个 某记录
        如果 某记录.状态 是 想要状态 则
            入列(结果, 某记录)
        结束
    结束
    返回 结果
结束

请 按主责人会计科目(全部结果, 主责人)
    定义 结果 = []
    遍历 全部结果 中的每个 某记录
        如果 某记录.主责人 是 主责人 则
            入列(结果, 某记录)
        结束
    结束
    返回 结果
结束

请 分页会计科目(全部结果, 页码, 每页)
    定义 起始 = (页码 - 1) * 每页
    如果 起始 >= 长度(全部结果) 则
        返回 []
    结束
    定义 结束位 = 起始 + 每页
    如果 结束位 > 长度(全部结果) 则
        结束位 = 长度(全部结果)
    结束
    返回 切片(全部结果, 起始, 结束位)
结束

请 计数会计科目(全部结果)
    返回 长度(全部结果)
结束

请 编号表会计科目(全部结果)
    定义 结果 = []
    遍历 全部结果 中的每个 某记录
        入列(结果, 某记录.编号)
    结束
    返回 结果
结束

请 状态分布会计科目(全部结果)
    定义 结果 = {}
    遍历 全部结果 中的每个 某记录
        定义 键 = 某记录.状态.名称
        如果 非 有键(结果, 键) 则
            结果[键] = 0
        结束
        结果[键] = 结果[键] + 1
    结束
    返回 结果
结束

请 排序会计科目按编号(全部结果)
    返回 排序依据(全部结果, 取记录编号)
结束

请 导出会计科目行(某记录)
    返回 [某记录.编号, 某记录.名称, 某记录.状态.名称,
    某记录.主责人, 某记录.建立日期]
结束

请 导出会计科目表(全部结果)
    定义 结果 = []
    遍历 全部结果 中的每个 某记录
        入列(结果, 导出会计科目行(某记录))
    结束
    返回 结果
结束


