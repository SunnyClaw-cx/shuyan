// ============================================================ 质量域 · 模型
//
// 检验标准、检验单、不合格品、纠正措施与批次追溯。
//
// 本文件只放**类型定义与构造辅助**，不含任何业务逻辑。
// 类型的字段顺序只在这里维护一次：字段增删只改本文件，
// 业务代码不受影响（它们一律走构造辅助）。

// 模型层只用内置函数，不依赖框架/基础 —— 保持最底层零依赖。

// ------------------------------------------------------------ 本域状态枚举

类型 本域状态 = { 草稿, 已提交, 已审批, 已执行, 已完成, 已作废 }


// ------------------------------------------------------------ 检验标准

类型 检验标准 = {
    编号: 文本,
    名称: 文本,
    状态: 本域状态,
    主责人: 文本,
    建立日期: 文本,
    分类: 文本,
    启用: 布尔,
    备注: 文本,
}

// ------------------------------------------------------------ 来料检验

类型 来料检验 = {
    编号: 文本,
    名称: 文本,
    状态: 本域状态,
    主责人: 文本,
    建立日期: 文本,
    单据状态: 文本,
    优先级: 整数,
    轮数: 整数,
}

// ------------------------------------------------------------ 过程检验

类型 过程检验 = {
    编号: 文本,
