// ============================================================ 批次追溯

// 校验：返回 [是否通过, 说明]
请 质量_批次追溯校验(某记录)
    定义 结果表 = [
    要求非空(某记录.编号, "编号"),
    要求非空(某记录.名称, "名称")
    ]
    返回 合并校验(结果表)
结束


请 质量_批次追溯层级校验(某记录)
    定义 结果表 = [
    要求非负(某记录.层级, "层级"),
    要求非负(某记录.排序号, "排序号")
    ]
    返回 合并校验(结果表)
结束

// 直接子节点
请 质量_批次追溯子节点(全部结果, 上级编号)
    定义 结果 = []
    遍历 全部结果 中的每个 某记录
        如果 某记录.上级编号 是 上级编号 则
            入列(结果, 某记录)
        结束
    结束
    返回 排序依据(结果, 质量_批次追溯取排序号)
结束

请 质量_批次追溯取排序号(某记录)
    返回 某记录.排序号
结束

// 子树全部节点（广度优先）
请 质量_批次追溯子树(全部结果, 起点编号)
    定义 结果 = []
    定义 待办 = [起点编号]
    当 长度(待办) > 0 成立
        定义 当前 = 待办[0]
        定义 剩余 = 切片(待办, 1)
        待办 = 剩余
        定义 孩子们 = 质量_批次追溯子节点(全部结果, 当前)
        遍历 孩子们 中的每个 某记录
            入列(结果, 某记录)
            入列(待办, 某记录.编号)
        结束
    结束
    返回 结果
结束

请 质量_批次追溯最大深度(全部结果)
    定义 最大层 = 0
    遍历 全部结果 中的每个 某记录
        如果 某记录.层级 > 最大层 则
            最大层 = 某记录.层级
        结束
    结束
    返回 最大层
结束

// 按层级分组计数
请 质量_批次追溯层级分布(全部结果)
    定义 结果 = {}
    遍历 全部结果 中的每个 某记录
        定义 键 = "第 " + 转文本(某记录.层级) + " 层"
        如果 非 有键(结果, 键) 则
            结果[键] = 0
        结束
        结果[键] = 结果[键] + 1
    结束
    返回 结果
结束


