// ============================================================ 框架/报表
//
// 报表引擎：所有「表格」都经这里渲染，列宽与对齐规则只有一份。
//
// 中文报表最容易出错的地方是**对齐** —— 汉字占两列，用字符长度算宽度
// 会让表头与数据错位。本工程一律用 `框架/基础` 的 `左对齐`/`右对齐`
// （底层走 `文本.填充`，按显示宽度补齐）。

引入 { 左对齐, 右对齐, 金额对齐, 分转元, 细线 } 从 "框架/基础"

类型 列定义 = {
    标题: 文本,
    宽度: 整数,
    对齐: 文本,
    格式: 文本
}

类型 表格 = {
    标题: 文本,
    列们: 列表,
    行们: 列表
}

// ------------------------------------------------------------ 构造

请 造列(标题, 宽度, 对齐, 格式)
    返回 列定义(标题 是 标题, 宽度 是 宽度, 对齐 是 对齐, 格式 是 格式)
结束

请 造表格(标题, 列们, 行们)
    返回 表格(标题 是 标题, 列们 是 列们, 行们 是 行们)
结束

// 文本列（左对齐）
请 文本列(标题, 宽度)
    返回 造列(标题, 宽度, "左", "文本")
结束

// 数值列（右对齐）
请 数值列(标题, 宽度)
    返回 造列(标题, 宽度, "右", "整数")
结束

// 金额列（右对齐，转元显示）
请 金额列(标题, 宽度)
    返回 造列(标题, 宽度, "右", "金额")
结束

// ------------------------------------------------------------ 渲染

// 单元格渲染：按列的对齐与格式决定
请 单元格(某列, 值)
    如果 某列.格式 是 "金额" 则
        如果 某列.对齐 是 "右" 则
            返回 金额对齐(值, 某列.宽度)
        结束
        返回 左对齐(分转元(值), 某列.宽度)
    结束
    如果 某列.对齐 是 "右" 则
        返回 右对齐(值, 某列.宽度)
    结束
    返回 左对齐(值, 某列.宽度)
结束

// 表头行
请 表头行(某表格)
    定义 部件 = []
    遍历 某表格.列们 中的每个 某列
        入列(部件, 文本.填充(某列.标题, 某列.宽度, " ", "中"))
    结束
    返回 连接(部件, " ")
结束

// 分隔行
请 表格线(某表格)
    定义 合计 = 0
    遍历 某表格.列们 中的每个 某列
        合计 = 合计 + 某列.宽度
    结束
    返回 细线(合计 + 长度(某表格.列们) - 1)
结束

// 数据行
请 数据行(某表格, 某行)
    定义 部件 = []
    定义 序号 = 0
    当 序号 < 长度(某表格.列们) 成立
        入列(部件, 单元格(某表格.列们[序号], 某行[序号]))
        序号 = 序号 + 1
    结束
    返回 连接(部件, " ")
结束

// 整表渲染（文本块）
请 渲染(某表格)
    定义 行 = []
    入列(行, 某表格.标题)
    入列(行, 表格线(某表格))
    入列(行, 表头行(某表格))
    入列(行, 表格线(某表格))
    遍历 某表格.行们 中的每个 某行
        入列(行, 数据行(某表格, 某行))
    结束
    入列(行, 表格线(某表格))
    返回 连接(行, "\n")
结束

// ------------------------------------------------------------ 常用聚合行

// 数值列求和（按下标取某列求和）
请 列合计(行们, 下标)
    定义 合计 = 0
    遍历 行们 中的每个 某行
        合计 = 合计 + 某行[下标]
    结束
    返回 合计
结束

// 汇总行（第一列写标签，某数值列填合计）
请 汇总行(列数, 标签, 数值下标, 合计值)
    定义 结果 = []
    定义 序号 = 0
    当 序号 < 列数 成立
        如果 序号 是 0 则
            入列(结果, 标签)
        否则如果 序号 是 数值下标 则
            入列(结果, 合计值)
        否则
            入列(结果, "")
        结束
        序号 = 序号 + 1
    结束
    返回 结果
结束
