// ============================================================ 框架/工作流
//
// 审批流引擎：把「单据怎么流转」从各业务模块里抽出来，做成通用状态机。
//
// 为什么必须抽出来：采购订单、销售订单、费用报销、请假单…… 审批**规则
// 千差万别，但流转骨架完全一样**（提交→逐级审批→通过/驳回→归档）。
// 若每个业务模块各写一遍，则「谁能驳回已通过的节点」这类边界必然
// 各处口径不一 —— 这是「同一语义多处实现必然分叉」的又一实例。

引入 { 左对齐, 右对齐 } 从 "框架/基础"
引入 "文本"

// ------------------------------------------------------------ 审批状态

类型 审批状态 = {
    待提交,
    审批流转,
    已通过,
    已驳回,
    已撤回,
    已归档
}

类型 审批节点 = {
    序号: 整数,
    节点名: 文本,
    审批人: 文本,
    结论: 文本,
    意见: 文本
}

类型 审批单 = {
    单号: 文本,
    主题: 文本,
    当前节点: 整数,
    节点数: 整数,
    状态: 审批状态,
    节点明细: 列表
}

// ------------------------------------------------------------ 构造

请 造节点(序号, 节点名, 审批人)
    返回 审批节点(序号 是 序号, 节点名 是 节点名, 审批人 是 审批人,
    结论 是 "待处理", 意见 是 "")
结束

// 造一张审批单：节点清单由调用方给出（每个节点只需名字与审批人）
请 造审批单(单号, 主题, 节点名表, 审批人表)
    定义 明细 = []
    定义 序号 = 1
    当 序号 <= 长度(节点名表) 成立
        入列(明细, 造节点(序号, 节点名表[序号 - 1], 审批人表[序号 - 1]))
        序号 = 序号 + 1
    结束
    返回 审批单(单号 是 单号, 主题 是 主题, 当前节点 是 1,
    节点数 是 长度(节点名表), 状态 是 审批状态.待提交, 节点明细 是 明细)
结束

// ------------------------------------------------------------ 状态判定

请 可提交(某单)
    返回 某单.状态 是 审批状态.待提交 或 某单.状态 是 审批状态.已驳回
结束

请 可审批(某单)
    返回 某单.状态 是 审批状态.审批流转
结束

请 可撤回(某单)
    返回 某单.状态 是 审批状态.审批流转
结束

请 已终结(某单)
    返回 某单.状态 是 审批状态.已通过 或 某单.状态 是 审批状态.已归档
结束

// 当前待办节点
请 当前节点(某单)
    如果 某单.当前节点 > 长度(某单.节点明细) 则
        返回 空
    结束
    返回 某单.节点明细[某单.当前节点 - 1]
结束

// ------------------------------------------------------------ 流转

// 提交：待提交/已驳回 → 审批流转
请 提交(某单)
    如果 非 可提交(某单) 则
        返回 [某单, "当前状态「" + 某单.状态.名称 + "」不能提交"]
    结束
    返回 [改状态(某单, 审批状态.审批流转), "已提交审批"]
结束

// 审批：通过当前节点则前进，末节点通过则整单通过
请 审批通过(某单, 意见)
    如果 非 可审批(某单) 则
        返回 [某单, "只有审批流转的单据可以审批"]
    结束
    定义 明细 = 回填节点(某单.节点明细, 某单.当前节点, "通过", 意见)
    如果 某单.当前节点 >= 某单.节点数 则
        定义 新单 = 审批单(单号 是 某单.单号, 主题 是 某单.主题,
        当前节点 是 某单.当前节点, 节点数 是 某单.节点数,
        状态 是 审批状态.已通过, 节点明细 是 明细)
        返回 [新单, "末级审批通过，流程结束"]
    结束
    定义 新单 = 审批单(单号 是 某单.单号, 主题 是 某单.主题,
    当前节点 是 某单.当前节点 + 1, 节点数 是 某单.节点数,
    状态 是 审批状态.审批流转, 节点明细 是 明细)
    返回 [新单, "节点「" + 取节点名(明细, 某单.当前节点) + "」通过"]
结束

// 驳回：回到待提交（保留已通过的节点结论，便于看到走到哪一步）
请 审批驳回(某单, 意见)
    如果 非 可审批(某单) 则
        返回 [某单, "只有审批流转的单据可以驳回"]
    结束
    定义 明细 = 回填节点(某单.节点明细, 某单.当前节点, "驳回", 意见)
    定义 新单 = 审批单(单号 是 某单.单号, 主题 是 某单.主题,
    当前节点 是 某单.当前节点, 节点数 是 某单.节点数,
    状态 是 审批状态.已驳回, 节点明细 是 明细)
    返回 [新单, "已驳回，可修改后重新提交"]
结束

请 撤回(某单)
    如果 非 可撤回(某单) 则
        返回 [某单, "只有审批流转的单据可以撤回"]
    结束
    返回 [改状态(某单, 审批状态.待提交), "已撤回，回到待提交"]
结束

// ------------------------------------------------------------ 内部工具

请 改状态(某单, 新状态)
    返回 审批单(单号 是 某单.单号, 主题 是 某单.主题,
    当前节点 是 某单.当前节点, 节点数 是 某单.节点数,
    状态 是 新状态, 节点明细 是 某单.节点明细)
结束

// 回填某节点的结论与意见（整体替换，不做就地改 —— 引用语义提醒）
请 回填节点(明细, 序号, 结论, 意见)
    定义 结果 = []
    遍历 明细 中的每个 某节点
        如果 某节点.序号 是 序号 则
            入列(结果, 审批节点(序号 是 某节点.序号, 节点名 是 某节点.节点名,
            审批人 是 某节点.审批人, 结论 是 结论, 意见 是 意见))
        否则
            入列(结果, 某节点)
        结束
    结束
    返回 结果
结束

请 取节点名(明细, 序号)
    遍历 明细 中的每个 某节点
        如果 某节点.序号 是 序号 则
            返回 某节点.节点名
        结束
    结束
    返回 ""
结束

// ------------------------------------------------------------ 统计

// 已通过的节点数
请 已通过数(某单)
    定义 合计 = 0
    遍历 某单.节点明细 中的每个 某节点
        如果 某节点.结论 是 "通过" 则
            合计 = 合计 + 1
        结束
    结束
    返回 合计
结束

// 流程进度（百分数整数）
请 进度(某单)
    如果 某单.节点数 是 0 则
        返回 0
    结束
    返回 数学.向下取整(已通过数(某单) * 100 / 某单.节点数)
结束

// 驳回节点清单（供「看看卡在哪」）
请 驳回节点(某单)
    定义 结果 = []
    遍历 某单.节点明细 中的每个 某节点
        如果 某节点.结论 是 "驳回" 则
            入列(结果, 某节点.节点名)
        结束
    结束
    返回 结果
结束

// 流程说明行
请 流程说明(某单)
    返回 某单.单号 + " " + 左对齐(某单.主题, 20) +
        左对齐(某单.状态.名称, 10) +
        " 进度 " + 右对齐(进度(某单), 3) + "%"
结束
