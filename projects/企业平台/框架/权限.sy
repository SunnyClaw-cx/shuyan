// ============================================================ 框架/权限
//
// 权限矩阵：把「角色 × 资源 × 动作」的三元判定收成一处。
//
// 常见做法是把权限判断散落在每个接口里（`如果 当前用户.角色 是 "财务" 则 …`）。
// 那样做的后果是：加一个角色要改几十处，且「只读用户能不能删除」这类
// 问题永远答不清。这里把判定抽成**唯一入口** `允许(...)`。

引入 { 左对齐, 右对齐 } 从 "框架/基础"

类型 授权 = {
    角色: 文本,
    资源: 文本,
    动作: 文本
}

类型 角色 = {
    名称: 文本,
    层级: 整数,
    说明: 文本
}

// ------------------------------------------------------------ 构造

请 造授权(角色, 资源, 动作)
    返回 授权(角色 是 角色, 资源 是 资源, 动作 是 动作)
结束

请 造角色(名称, 层级, 说明)
    返回 角色(名称 是 名称, 层级 是 层级, 说明 是 说明)
结束

// 通配：资源或动作为 "*" 时匹配任意
请 命中(某授权, 角色, 资源, 动作)
    如果 某授权.角色 != 角色 则
        返回 假
    结束
    如果 某授权.资源 != "*" 且 某授权.资源 != 资源 则
        返回 假
    结束
    如果 某授权.动作 != "*" 且 某授权.动作 != 动作 则
        返回 假
    结束
    返回 真
结束

// 唯一判定入口
请 允许(全部授权, 角色, 资源, 动作)
    遍历 全部授权 中的每个 某授权
        如果 命中(某授权, 角色, 资源, 动作) 则
            返回 真
        结束
    结束
    返回 假
结束

// 某角色的全部动作（去重）
请 动作表(全部授权, 角色, 资源)
    定义 结果 = []
    遍历 全部授权 中的每个 某授权
        如果 某授权.角色 是 角色 且 某授权.资源 是 资源 则
            如果 非 包含(结果, 某授权.动作) 则
                入列(结果, 某授权.动作)
            结束
        结束
    结束
    返回 结果
结束

// 某角色的资源清单
请 资源表(全部授权, 角色)
    定义 结果 = []
    遍历 全部授权 中的每个 某授权
        如果 某授权.角色 是 角色 则
            如果 非 包含(结果, 某授权.资源) 则
                入列(结果, 某授权.资源)
            结束
        结束
    结束
    返回 结果
结束

// 细粒度授权条数（不含通配）
请 精确条数(全部授权)
    定义 合计 = 0
    遍历 全部授权 中的每个 某授权
        如果 某授权.资源 != "*" 且 某授权.动作 != "*" 则
            合计 = 合计 + 1
        结束
    结束
    返回 合计
结束

// 授权覆盖度（精确条数 / 全部条数，百分数）
请 覆盖度(全部授权)
    如果 长度(全部授权) 是 0 则
        返回 0
    结束
    返回 数学.向下取整(精确条数(全部授权) * 100 / 长度(全部授权))
结束

// 角色层级排序（高层级在前）
请 按层级排(全部角色)
    返回 排序依据(全部角色, 取层级, 真)
结束

请 取层级(某角色)
    返回 某角色.层级
结束

// 权限审计行
请 权限说明(某角色, 资源数, 动作数)
    返回 左对齐(某角色.名称, 12) + " 层级 " + 右对齐(某角色.层级, 3) +
        " 资源 " + 右对齐(资源数, 3) + " 动作 " + 右对齐(动作数, 3)
结束
