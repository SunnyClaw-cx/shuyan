    文本列("编号", 14),
    文本列("名称", 18),
    文本列("上级", 14),
    数值列("层级", 8)
    ]
    定义 行们 = []
    遍历 排序依据(全部结果, 研发_物料清单取层级号) 中的每个 某记录
        入列(行们, [某记录.编号, 某记录.名称, 某记录.上级编号,
        某记录.层级])
