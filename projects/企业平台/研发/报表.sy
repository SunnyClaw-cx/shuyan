// ============================================================ 研发域 · 报表
//
// 报表层：只做**呈现**，不含业务判定。
// 表格一律经 `框架/报表` 渲染 —— 列宽与对齐规则只有一份。

引入 "框架/报表"
引入 "研发/模型"
引入 "研发/服务"
引入 { 右对齐, 左对齐, 账龄名 } 从 "框架/基础"
引入 { 数值列, 文本列, 造表格, 金额列 } 从 "框架/报表"
引入 { 研发_研发台账净额, 研发_研发台账净额合计, 研发_研发台账税额合计 } 从 "研发/服务"
引入 { 研发_研发台账金额合计, 研发_研发费用净额, 研发_研发费用净额合计 } 从 "研发/服务"
引入 { 研发_研发费用税额合计, 研发_研发费用金额合计, 研发_试验记录到期日 } 从 "研发/服务"
引入 { 研发_试验记录按桶统计, 研发_试验记录账龄桶, 研发_试验记录逾期天数 } 从 "研发/服务"


// ------------------------------------------------------------ 物料编码 报表

请 研发_物料编码明细表(全部结果)
    定义 列们 = [
    文本列("编号", 14),
    文本列("名称", 18),
    文本列("状态", 8),
    文本列("主责人", 10),
    文本列("建立日期", 12)
    ]
    定义 行们 = []
    遍历 全部结果 中的每个 某记录
        入列(行们, [某记录.编号, 某记录.名称, 某记录.状态.名称,
        某记录.主责人, 某记录.建立日期])
    结束
    返回 造表格("物料编码明细", 列们, 行们)
结束

请 研发_物料编码状态汇总(全部结果)
    定义 分布 = {}
    遍历 全部结果 中的每个 某记录
        定义 键 = 某记录.状态.名称
        如果 非 有键(分布, 键) 则
            分布[键] = 0
        结束
        分布[键] = 分布[键] + 1
    结束
    定义 列们 = [文本列("状态", 12), 数值列("条数", 8)]
    定义 行们 = []
    遍历 取键(分布) 中的每个 某键
        入列(行们, [某键, 分布[某键]])
    结束
    入列(行们, ["合计", 长度(全部结果)])
    返回 造表格("物料编码状态分布", 列们, 行们)
结束

请 研发_物料编码看板行(全部结果)
    返回 左对齐("物料编码", 12) + 右对齐(长度(全部结果), 6) + " 条"
    结束


