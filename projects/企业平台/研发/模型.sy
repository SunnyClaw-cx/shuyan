// ============================================================ 研发域 · 模型
//
// 物料编码、BOM、工艺、图纸与变更管理。
//
// 本文件只放**类型定义与构造辅助**，不含任何业务逻辑。
// 类型的字段顺序只在这里维护一次：字段增删只改本文件，
// 业务代码不受影响（它们一律走构造辅助）。

// 模型层只用内置函数，不依赖框架/基础 —— 保持最底层零依赖。

// ------------------------------------------------------------ 本域状态枚举

类型 本域状态 = { 草稿, 已提交, 已审批, 已执行, 已完成, 已作废 }


// ------------------------------------------------------------ 物料编码

类型 物料编码 = {
    编号: 文本,
    名称: 文本,
    状态: 本域状态,
    主责人: 文本,
    建立日期: 文本,
    分类: 文本,
    启用: 布尔,
    备注: 文本,
}

// ------------------------------------------------------------ 物料清单

类型 物料清单 = {
    编号: 文本,
    名称: 文本,
    状态: 本域状态,
    主责人: 文本,
    建立日期: 文本,
    上级编号: 文本,
    层级: 整数,
    排序号: 整数,
}

// ------------------------------------------------------------ 工艺规程

类型 工艺规程 = {
    编号: 文本,
    名称: 文本,
