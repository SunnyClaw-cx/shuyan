// ============================================================ 审批流演示

定义 采购审批 = 造审批单("SP-0001", "采购订单审批",
    ["部门经理", "采购总监", "财务经理"],
    ["张三1", "张三2", "张三3"])

输出(流程说明(采购审批))
定义 提交结果 = 提交(采购审批)
采购审批 = 提交结果[0]
输出("  提交：" + 提交结果[1])

定义 第一审 = 审批通过(采购审批, "同意")
采购审批 = 第一审[0]
输出("  " + 第一审[1])

定义 第二审 = 审批通过(采购审批, "同意")
采购审批 = 第二审[0]
输出("  " + 第二审[1])

定义 驳回 = 审批驳回(采购审批, "预算超支")
采购审批 = 驳回[0]
输出("  " + 驳回[1])
输出("  已通过 " + 转文本(已通过数(采购审批)) + " 个节点，进度 " +
    转文本(进度(采购审批)) + "%")


// ============================================================ 事件总线

定义 订阅表 = [
造订阅("采购收货", "库存入库", "库存域监听"),
造订阅("采购收货", "应付入账", "财务域监听"),
造订阅("销售发货", "库存出库", "库存域监听"),
造订阅("生产完工", "库存入库", "库存域监听")
]

定义 一个事件 = 造事件("EV-0001", "采购收货", "采购域",
    {"单号": "CG-0001", "金额": 123456}, "2026-10-20")
定义 处理者 = 派发(订阅表, 一个事件)
输出(派发说明(一个事件, 处理者))


// ============================================================ 权限矩阵

定义 角色表 = [
造角色("管理员", 1, "全部权限"),
造角色("财务", 2, "财务与报表"),
造角色("采购", 3, "采购业务")
]

定义 授权表 = [
造授权("管理员", "*", "*"),
造授权("财务", "会计凭证", "增删改查"),
造授权("财务", "财务报表", "查看"),
造授权("采购", "采购订单", "增删改查"),
造授权("采购", "供应商", "查看")
]

输出("管理员能否删除会计凭证：" + 转文本(允许(授权表, "管理员", "会计凭证", "删除")))
输出("财务能否删除会计凭证：" + 转文本(允许(授权表, "财务", "会计凭证", "删除")))
输出("采购能否查看财务报表：" + 转文本(允许(授权表, "采购", "财务报表", "查看")))
输出("角色层级（按授权条数排）：")
遍历 按层级排(角色表) 中的每个 某角色
    输出("  " + 某角色.名称 + " · 第 " + 转文本(某角色.层级) + " 级")
结束


// ============================================================ 规则引擎

定义 规则示例 = [
造规则("R-001", "金额上限", "拦截", "金额 > 1000000", "超过审批上限"),
造规则("R-002", "供应商资质", "警告", "资质过期", "需复核资质"),
造规则("R-003", "价格偏离", "提示", "偏离基准价 10%", "建议复核定价")
]

定义 判定表 = [
[规则示例[0], 真],
[规则示例[1], 假],
[规则示例[2], 真]
]
定义 命中们 = 命中项清单(判定表)
遍历 命中们 中的每个 某项
    输出("  " + 命中行(某项))
结束
输出(结论摘要(命中们))


// ============================================================ 审计留痕

