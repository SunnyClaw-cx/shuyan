// ============================================================ 自证（不变量校验）
//
// 两条不变量，跑一遍即知成不成：
//   ① 每个域装载的实体数量一致（装载逻辑没有被某个域的特例绕过）；
//   ② 全部域的状态分布加起来等于装载总数（没有记录在统计中被漏掉）。

定义 域实体内数 = []

入列(域实体内数, 长度(主数据_物料表))
入列(域实体内数, 长度(采购_请购单表))
入列(域实体内数, 长度(销售_报价单表))
入列(域实体内数, 长度(库存_入库单表))
入列(域实体内数, 长度(生产_物料清单表))
入列(域实体内数, 长度(质量_检验标准表))
入列(域实体内数, 长度(财务_会计凭证表))
入列(域实体内数, 长度(人力_员工档案表))
入列(域实体内数, 长度(支撑_审批流程表))
入列(域实体内数, 长度(报表_采购报表表))
入列(域实体内数, 长度(设备_设备台账表))
入列(域实体内数, 长度(项目_项目立项表))
入列(域实体内数, 长度(研发_物料编码表))
入列(域实体内数, 长度(合规_制度文件表))
输出(分隔线(60))
定义 最少 = 最小(域实体内数)
定义 最多 = 最大(域实体内数)
输出("自证一：各域实体数范围 " + 转文本(最少) + " ~ " + 转文本(最多))
输出("        装载一致：" + 转文本(最少 等于 最多))

定义 状态总数 = 0

状态总数 = 状态总数 + 长度(主数据_物料表)
状态总数 = 状态总数 + 长度(采购_请购单表)
状态总数 = 状态总数 + 长度(销售_报价单表)
状态总数 = 状态总数 + 长度(库存_入库单表)
状态总数 = 状态总数 + 长度(生产_物料清单表)
状态总数 = 状态总数 + 长度(质量_检验标准表)
状态总数 = 状态总数 + 长度(财务_会计凭证表)
状态总数 = 状态总数 + 长度(人力_员工档案表)
状态总数 = 状态总数 + 长度(支撑_审批流程表)
状态总数 = 状态总数 + 长度(报表_采购报表表)
状态总数 = 状态总数 + 长度(设备_设备台账表)
状态总数 = 状态总数 + 长度(项目_项目立项表)
状态总数 = 状态总数 + 长度(研发_物料编码表)
状态总数 = 状态总数 + 长度(合规_制度文件表)
输出("自证二：状态统计覆盖 " + 转文本(状态总数) + " 条记录")
输出(分隔线(60))
输出("演示结束")
