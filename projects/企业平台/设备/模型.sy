// ------------------------------------------------------------ 设备台账表

类型 设备台账表 = {
    编号: 文本,
    名称: 文本,
    状态: 本域状态,
    主责人: 文本,
    建立日期: 文本,
    分类: 文本,
    启用: 布尔,
    备注: 文本,
}

请 设备_造状态(名)
    如果 名 是 "草稿" 则
        返回 本域状态.草稿
    结束
    如果 名 是 "已提交" 则
        返回 本域状态.已提交
    结束
    如果 名 是 "已审批" 则
        返回 本域状态.已审批
    结束
    如果 名 是 "已执行" 则
        返回 本域状态.已执行
    结束
    如果 名 是 "已完成" 则
        返回 本域状态.已完成
    结束
    返回 本域状态.已作废
结束


请 设备_造设备台账(编号, 名称, 状态, 主责人, 建立日期, 分类, 启用, 备注)
    返回 设备台账(编号 是 编号, 名称 是 名称, 状态 是 状态,
    主责人 是 主责人, 建立日期 是 建立日期,
    分类 是 分类, 启用 是 启用, 备注 是 备注)
结束

请 设备_造设备点检(编号, 名称, 状态, 主责人, 建立日期, 发生日期, 账期天数, 逾期天数)
    返回 设备点检(编号 是 编号, 名称 是 名称, 状态 是 状态,
