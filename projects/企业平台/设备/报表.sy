    定义 列们 = [
    文本列("编号", 14),
    文本列("到期日", 12),
    数值列("逾期天数", 10),
    文本列("账龄", 12)
    ]
    定义 行们 = []
    遍历 全部结果 中的每个 某记录
        定义 桶 = 设备_设备点检账龄桶(某记录, 基准日)
        入列(行们, [某记录.编号, 设备_设备点检到期日(某记录),
        设备_设备点检逾期天数(某记录, 基准日), 账龄名(桶)])
    结束
    返回 造表格("设备点检账龄分析", 列们, 行们)
结束

