请 报表_采购报表判定(某记录)
    定义 规则们 = 报表_采购报表规则表()
    定义 判定表 = [
    [规则们[0], 某记录.金额 > 1 * 1000],
    [规则们[1], 某记录.金额 > 2 * 1000],
    [规则们[2], 某记录.金额 > 3 * 1000],
