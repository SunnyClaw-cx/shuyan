// ============================================================ 报表域 · 报表
//
// 报表层：只做**呈现**，不含业务判定。
// 表格一律经 `框架/报表` 渲染 —— 列宽与对齐规则只有一份。

引入 "框架/报表"
引入 "报表/模型"
引入 "报表/服务"
引入 { 报表_人效报表数量合计, 报表_人效报表金额, 报表_人效报表金额合计 } 从 "报表/服务"
引入 { 报表_同比分析净额, 报表_同比分析净额合计, 报表_同比分析税额合计 } 从 "报表/服务"
引入 { 报表_同比分析金额合计, 报表_库存报表数量合计, 报表_库存报表金额 } 从 "报表/服务"
引入 { 报表_库存报表金额合计, 报表_毛利分析净额, 报表_毛利分析净额合计 } 从 "报表/服务"
引入 { 报表_毛利分析税额合计, 报表_毛利分析金额合计, 报表_生产报表数量合计 } 从 "报表/服务"
引入 { 报表_生产报表金额, 报表_生产报表金额合计, 报表_经营指标净额 } 从 "报表/服务"
引入 { 报表_经营指标净额合计, 报表_经营指标税额合计, 报表_经营指标金额合计 } 从 "报表/服务"
引入 { 报表_综合看板净额, 报表_综合看板净额合计, 报表_综合看板税额合计 } 从 "报表/服务"
引入 { 报表_综合看板金额合计, 报表_财务报表净额, 报表_财务报表净额合计 } 从 "报表/服务"
引入 { 报表_财务报表税额合计, 报表_财务报表金额合计, 报表_质量报表数量合计 } 从 "报表/服务"
引入 { 报表_质量报表金额, 报表_质量报表金额合计, 报表_趋势分析到期日 } 从 "报表/服务"
引入 { 报表_趋势分析按桶统计, 报表_趋势分析账龄桶, 报表_趋势分析逾期天数 } 从 "报表/服务"
引入 { 报表_采购报表净额, 报表_采购报表净额合计, 报表_采购报表税额合计 } 从 "报表/服务"
引入 { 报表_采购报表金额合计, 报表_销售报表净额, 报表_销售报表净额合计 } 从 "报表/服务"
引入 { 报表_销售报表税额合计, 报表_销售报表金额合计 } 从 "报表/服务"
引入 { 右对齐, 左对齐, 账龄名 } 从 "框架/基础"
引入 { 数值列, 文本列, 造表格, 金额列 } 从 "框架/报表"


// ------------------------------------------------------------ 采购报表 报表

请 报表_采购报表明细表(全部结果)
    定义 列们 = [
    文本列("编号", 14),
    文本列("名称", 18),
    文本列("状态", 8),
    文本列("主责人", 10),
    文本列("建立日期", 12)
    ]
    定义 行们 = []
    遍历 全部结果 中的每个 某记录
        入列(行们, [某记录.编号, 某记录.名称, 某记录.状态.名称,
        某记录.主责人, 某记录.建立日期])
    结束
    返回 造表格("采购报表明细", 列们, 行们)
结束

请 报表_采购报表状态汇总(全部结果)
    定义 分布 = {}
    遍历 全部结果 中的每个 某记录
        定义 键 = 某记录.状态.名称
        如果 非 有键(分布, 键) 则
            分布[键] = 0
        结束
        分布[键] = 分布[键] + 1
    结束
    定义 列们 = [文本列("状态", 12), 数值列("条数", 8)]
    定义 行们 = []
    遍历 取键(分布) 中的每个 某键
        入列(行们, [某键, 分布[某键]])
    结束
    入列(行们, ["合计", 长度(全部结果)])
    返回 造表格("采购报表状态分布", 列们, 行们)
结束

请 报表_采购报表看板行(全部结果)
    返回 左对齐("采购报表", 12) + 右对齐(长度(全部结果), 6) + " 条"
    结束


请 报表_采购报表金额表(全部结果)
    定义 列们 = [
    文本列("名称", 18),
    金额列("金额", 16),
    金额列("税额", 14),
    金额列("净额", 16)
    ]
    定义 行们 = []
    遍历 全部结果 中的每个 某记录
        入列(行们, [某记录.名称, 某记录.金额, 某记录.税额,
        报表_采购报表净额(某记录)])
    结束
    入列(行们, ["合计", 报表_采购报表金额合计(全部结果),
    报表_采购报表税额合计(全部结果), 报表_采购报表净额合计(全部结果)])
    返回 造表格("采购报表金额汇总", 列们, 行们)
结束


