// 子树全部节点（广度优先）
请 生产_工艺路线子树(全部结果, 起点编号)
    定义 结果 = []
    定义 待办 = [起点编号]
    当 长度(待办) > 0 成立
        定义 当前 = 待办[0]
        定义 剩余 = 切片(待办, 1)
        待办 = 剩余
        定义 孩子们 = 生产_工艺路线子节点(全部结果, 当前)
        遍历 孩子们 中的每个 某记录
            入列(结果, 某记录)
            入列(待办, 某记录.编号)
        结束
    结束
    返回 结果
结束

请 生产_工艺路线最大深度(全部结果)
    定义 最大层 = 0
    遍历 全部结果 中的每个 某记录
        如果 某记录.层级 > 最大层 则
            最大层 = 某记录.层级
        结束
    结束
    返回 最大层
结束

// 按层级分组计数
请 生产_工艺路线层级分布(全部结果)
    定义 结果 = {}
    遍历 全部结果 中的每个 某记录
        定义 键 = "第 " + 转文本(某记录.层级) + " 层"
        如果 非 有键(结果, 键) 则
            结果[键] = 0
        结束
        结果[键] = 结果[键] + 1
    结束
    返回 结果
结束


// ============================================================ 生产工单

// 校验：返回 [是否通过, 说明]
请 生产_生产工单校验(某记录)
    定义 结果表 = [
    要求非空(某记录.编号, "编号"),
    要求非空(某记录.名称, "名称")
    ]
    返回 合并校验(结果表)
结束


// 状态机：允许的流转（唯一判据，不在别处再写一遍）
请 生产_生产工单可流转(当前, 目标)
    如果 当前 是 本域状态.草稿 则
        返回 目标 是 本域状态.已提交
    结束
    如果 当前 是 本域状态.已提交 则
        返回 目标 是 本域状态.已审批 或 目标 是 本域状态.已作废
    结束
    如果 当前 是 本域状态.已审批 则
        返回 目标 是 本域状态.已执行
    结束
    如果 当前 是 本域状态.已执行 则
        返回 目标 是 本域状态.已完成
    结束
    返回 假
结束

请 生产_生产工单推进(某记录, 目标)
    如果 非 生产_生产工单可流转(某记录.状态, 目标) 则
        返回 [某记录, "不能从「" + 某记录.状态.名称 + "」流转到「" +
            目标.名称 + "」"]
    结束
    定义 新记录 = 生产工单(编号 是 某记录.编号, 名称 是 某记录.名称,
    状态 是 目标, 主责人 是 某记录.主责人, 建立日期 是 某记录.建立日期,
    单据状态 是 某记录.单据状态, 优先级 是 某记录.优先级, 轮数 是 某记录.轮数)
    返回 [新记录, "已流转到「" + 目标.名称 + "」"]
结束

请 生产_生产工单轮数合计(全部结果)
    定义 合计 = 0
    遍历 全部结果 中的每个 某记录
        合计 = 合计 + 某记录.轮数
    结束
    返回 合计
结束

请 生产_生产工单优先级合计(全部结果)
    定义 合计 = 0
    遍历 全部结果 中的每个 某记录
        合计 = 合计 + 某记录.优先级
    结束
    返回 合计
结束

请 生产_生产工单高优先(全部结果, 阈值)
    定义 结果 = []
    遍历 全部结果 中的每个 某记录
        如果 某记录.优先级 >= 阈值 则
            入列(结果, 某记录)
        结束
    结束
    返回 结果
结束


// ============================================================ 生产报工

// 校验：返回 [是否通过, 说明]
请 生产_生产报工校验(某记录)
    定义 结果表 = [
    要求非空(某记录.编号, "编号"),
    要求非空(某记录.名称, "名称")
    ]
    返回 合并校验(结果表)
结束


请 生产_生产报工数量校验(某记录)
    定义 结果表 = [
    要求非负(某记录.数量, "数量"),
    要求非负(某记录.重量, "重量")
    ]
    返回 合并校验(结果表)
结束

请 生产_生产报工金额(某记录)
    返回 某记录.数量 * 某记录.单价
结束

请 生产_生产报工数量合计(全部结果)
    定义 合计 = 0
    遍历 全部结果 中的每个 某记录
        合计 = 合计 + 某记录.数量
    结束
    返回 合计
结束

请 生产_生产报工重量合计(全部结果)
    定义 合计 = 0
    遍历 全部结果 中的每个 某记录
        合计 = 合计 + 某记录.重量
    结束
    返回 合计
结束

请 生产_生产报工金额合计(全部结果)
    定义 合计 = 0
    遍历 全部结果 中的每个 某记录
        合计 = 合计 + 生产_生产报工金额(某记录)
    结束
    返回 合计
结束

// 均价（金额 ÷ 数量），数量为 0 返回 0
请 生产_生产报工均价(全部结果)
    定义 数量合计 = 生产_生产报工数量合计(全部结果)
    如果 数量合计 <= 0 则
        返回 0
    结束
    返回 数学.向下取整(生产_生产报工金额合计(全部结果) / 数量合计)
结束

请 生产_生产报工低于安全线(全部结果, 安全线)
    定义 结果 = []
    遍历 全部结果 中的每个 某记录
        如果 某记录.数量 < 安全线 则
            入列(结果, 某记录)
        结束
    结束
    返回 结果
结束


