    造规则("生产-物料清单-009", "物料清单规则9", "拦截", "条件9", "结论9"),
    造规则("生产-物料清单-010", "物料清单规则10", "警告", "条件10", "结论10"),
    造规则("生产-物料清单-011", "物料清单规则11", "提示", "条件11", "结论11"),
    造规则("生产-物料清单-012", "物料清单规则12", "拦截", "条件12", "结论12"),
    造规则("生产-物料清单-013", "物料清单规则13", "警告", "条件13", "结论13"),
