// ============================================================ 采购域 · 模型
//
// 从请购到付款申请的全流程：请购、询价、订单、收货、退货、对账。
//
// 本文件只放**类型定义与构造辅助**，不含任何业务逻辑。
// 类型的字段顺序只在这里维护一次：字段增删只改本文件，
// 业务代码不受影响（它们一律走构造辅助）。

// 模型层只用内置函数，不依赖框架/基础 —— 保持最底层零依赖。

// ------------------------------------------------------------ 本域状态枚举

类型 本域状态 = { 草稿, 已提交, 已审批, 已执行, 已完成, 已作废 }


// ------------------------------------------------------------ 请购单

类型 请购单 = {
    编号: 文本,
    名称: 文本,
    状态: 本域状态,
    主责人: 文本,
    建立日期: 文本,
    单据状态: 文本,
    优先级: 整数,
    轮数: 整数,
}

// ------------------------------------------------------------ 询价单

类型 询价单 = {
    编号: 文本,
    名称: 文本,
    状态: 本域状态,
    主责人: 文本,
    建立日期: 文本,
    金额: 整数,
    税额: 整数,
    净额: 整数,
}

