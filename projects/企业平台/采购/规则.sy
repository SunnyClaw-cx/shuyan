// ============================================================ 采购域 · 规则
//
// 规则层：把本域所有的「拦得住 / 提醒」判定收成**可枚举的规则表**。
//
// 为什么要有这层：业务规则会随监管与内控要求不断加。若它们散落在服务
// 函数里，没人答得出「一共多少条规则、哪条最严」。这里每条规则都是
// 一个具名结构体，可列举、可统计、可按严重度排序。

引入 "框架/规则"
引入 "采购/模型"
引入 { 请购单, 询价单, 采购订单, 采购收货, 采购退货, 采购对账, 付款申请, 供应商报价 } 从 "采购/模型"
引入 { 采购合同, 采购预算, 采购比价, 采购台账 } 从 "采购/模型"
引入 { 命中项清单, 有拦截, 造规则 } 从 "框架/规则"


// ------------------------------------------------------------ 请购单 规则

请 采购_请购单规则表()
    定义 结果 = [
    造规则("采购-请购单-001", "请购单规则1", "警告", "条件1", "结论1"),
    造规则("采购-请购单-002", "请购单规则2", "提示", "条件2", "结论2"),
    造规则("采购-请购单-003", "请购单规则3", "拦截", "条件3", "结论3"),
    造规则("采购-请购单-004", "请购单规则4", "警告", "条件4", "结论4"),
    造规则("采购-请购单-005", "请购单规则5", "提示", "条件5", "结论5"),
    造规则("采购-请购单-006", "请购单规则6", "拦截", "条件6", "结论6"),
    造规则("采购-请购单-007", "请购单规则7", "警告", "条件7", "结论7"),
    造规则("采购-请购单-008", "请购单规则8", "提示", "条件8", "结论8"),
    造规则("采购-请购单-009", "请购单规则9", "拦截", "条件9", "结论9"),
    造规则("采购-请购单-010", "请购单规则10", "警告", "条件10", "结论10"),
    造规则("采购-请购单-011", "请购单规则11", "提示", "条件11", "结论11"),
    造规则("采购-请购单-012", "请购单规则12", "拦截", "条件12", "结论12"),
    造规则("采购-请购单-013", "请购单规则13", "警告", "条件13", "结论13"),
    造规则("采购-请购单-014", "请购单规则14", "提示", "条件14", "结论14"),
    造规则("采购-请购单-015", "请购单规则15", "拦截", "条件15", "结论15"),
    造规则("采购-请购单-016", "请购单规则16", "警告", "条件16", "结论16"),
    造规则("采购-请购单-017", "请购单规则17", "提示", "条件17", "结论17"),
