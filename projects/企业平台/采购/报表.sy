    定义 列们 = [
    文本列("名称", 18),
    金额列("金额", 16),
    金额列("税额", 14),
    金额列("净额", 16)
    ]
    定义 行们 = []
    遍历 全部结果 中的每个 某记录
        入列(行们, [某记录.名称, 某记录.金额, 某记录.税额,
        采购_询价单净额(某记录)])
    结束
    入列(行们, ["合计", 采购_询价单金额合计(全部结果),
    采购_询价单税额合计(全部结果), 采购_询价单净额合计(全部结果)])
