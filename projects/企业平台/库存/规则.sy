    造规则("库存-入库单-010", "入库单规则10", "警告", "条件10", "结论10"),
    造规则("库存-入库单-011", "入库单规则11", "提示", "条件11", "结论11"),
    造规则("库存-入库单-012", "入库单规则12", "拦截", "条件12", "结论12"),
    造规则("库存-入库单-013", "入库单规则13", "警告", "条件13", "结论13"),
    造规则("库存-入库单-014", "入库单规则14", "提示", "条件14", "结论14"),
