// ============================================================ 库存域 · 模型
//
// 出入库、调拨、盘点、批次与安全库存。
//
// 本文件只放**类型定义与构造辅助**，不含任何业务逻辑。
// 类型的字段顺序只在这里维护一次：字段增删只改本文件，
// 业务代码不受影响（它们一律走构造辅助）。

// 模型层只用内置函数，不依赖框架/基础 —— 保持最底层零依赖。

// ------------------------------------------------------------ 本域状态枚举

类型 本域状态 = { 草稿, 已提交, 已审批, 已执行, 已完成, 已作废 }


// ------------------------------------------------------------ 入库单

类型 入库单 = {
    编号: 文本,
    名称: 文本,
    状态: 本域状态,
    主责人: 文本,
    建立日期: 文本,
    数量: 整数,
    单价: 整数,
    重量: 整数,
}

// ------------------------------------------------------------ 出库单

类型 出库单 = {
    编号: 文本,
    名称: 文本,
    状态: 本域状态,
    主责人: 文本,
    建立日期: 文本,
    数量: 整数,
    单价: 整数,
    重量: 整数,
}

