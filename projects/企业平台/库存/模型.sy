类型 库存周转 = {
    编号: 文本,
    名称: 文本,
    状态: 本域状态,
    主责人: 文本,
    建立日期: 文本,
    数量: 整数,
    单价: 整数,
    重量: 整数,
}

请 库存_造状态(名)
    如果 名 是 "草稿" 则
        返回 本域状态.草稿
    结束
    如果 名 是 "已提交" 则
        返回 本域状态.已提交
    结束
    如果 名 是 "已审批" 则
        返回 本域状态.已审批
    结束
    如果 名 是 "已执行" 则
        返回 本域状态.已执行
    结束
    如果 名 是 "已完成" 则
        返回 本域状态.已完成
    结束
    返回 本域状态.已作废
结束


请 库存_造入库单(编号, 名称, 状态, 主责人, 建立日期, 数量, 单价, 重量)
    返回 入库单(编号 是 编号, 名称 是 名称, 状态 是 状态,
    主责人 是 主责人, 建立日期 是 建立日期,
    数量 是 数量, 单价 是 单价, 重量 是 重量)
结束

请 库存_造出库单(编号, 名称, 状态, 主责人, 建立日期, 数量, 单价, 重量)
    返回 出库单(编号 是 编号, 名称 是 名称, 状态 是 状态,
    主责人 是 主责人, 建立日期 是 建立日期,
    数量 是 数量, 单价 是 单价, 重量 是 重量)
结束

请 库存_造库存调拨(编号, 名称, 状态, 主责人, 建立日期, 数量, 单价, 重量)
    返回 库存调拨(编号 是 编号, 名称 是 名称, 状态 是 状态,
