// ============================================================ 库存域 · 报表
//
// 报表层：只做**呈现**，不含业务判定。
// 表格一律经 `框架/报表` 渲染 —— 列宽与对齐规则只有一份。

引入 "框架/报表"
引入 "库存/模型"
引入 "库存/服务"
引入 { 库存_入库单数量合计, 库存_入库单金额, 库存_入库单金额合计 } 从 "库存/服务"
引入 { 库存_出库单数量合计, 库存_出库单金额, 库存_出库单金额合计 } 从 "库存/服务"
引入 { 库存_呆滞物料到期日, 库存_呆滞物料按桶统计, 库存_呆滞物料账龄桶 } 从 "库存/服务"
引入 { 库存_呆滞物料逾期天数, 库存_安全库存数量合计, 库存_安全库存金额 } 从 "库存/服务"
引入 { 库存_安全库存金额合计, 库存_库存估值净额, 库存_库存估值净额合计 } 从 "库存/服务"
引入 { 库存_库存估值税额合计, 库存_库存估值金额合计, 库存_库存台账数量合计 } 从 "库存/服务"
引入 { 库存_库存台账金额, 库存_库存台账金额合计, 库存_库存周转数量合计 } 从 "库存/服务"
引入 { 库存_库存周转金额, 库存_库存周转金额合计, 库存_库存盘点数量合计 } 从 "库存/服务"
引入 { 库存_库存盘点金额, 库存_库存盘点金额合计, 库存_库存调拨数量合计 } 从 "库存/服务"
引入 { 库存_库存调拨金额, 库存_库存调拨金额合计, 库存_库存预警数量合计 } 从 "库存/服务"
引入 { 库存_库存预警金额, 库存_库存预警金额合计, 库存_库龄分析到期日 } 从 "库存/服务"
引入 { 库存_库龄分析按桶统计, 库存_库龄分析账龄桶, 库存_库龄分析逾期天数 } 从 "库存/服务"
引入 { 库存_批次档案到期日, 库存_批次档案按桶统计, 库存_批次档案账龄桶 } 从 "库存/服务"
引入 { 库存_批次档案逾期天数 } 从 "库存/服务"
引入 { 右对齐, 左对齐, 账龄名 } 从 "框架/基础"
引入 { 数值列, 文本列, 造表格, 金额列 } 从 "框架/报表"


// ------------------------------------------------------------ 入库单 报表

请 库存_入库单明细表(全部结果)
    定义 列们 = [
    文本列("编号", 14),
    文本列("名称", 18),
    文本列("状态", 8),
    文本列("主责人", 10),
    文本列("建立日期", 12)
    ]
    定义 行们 = []
    遍历 全部结果 中的每个 某记录
        入列(行们, [某记录.编号, 某记录.名称, 某记录.状态.名称,
        某记录.主责人, 某记录.建立日期])
    结束
    返回 造表格("入库单明细", 列们, 行们)
结束

请 库存_入库单状态汇总(全部结果)
    定义 分布 = {}
    遍历 全部结果 中的每个 某记录
        定义 键 = 某记录.状态.名称
        如果 非 有键(分布, 键) 则
            分布[键] = 0
        结束
        分布[键] = 分布[键] + 1
    结束
    定义 列们 = [文本列("状态", 12), 数值列("条数", 8)]
    定义 行们 = []
    遍历 取键(分布) 中的每个 某键
        入列(行们, [某键, 分布[某键]])
    结束
    入列(行们, ["合计", 长度(全部结果)])
    返回 造表格("入库单状态分布", 列们, 行们)
结束

请 库存_入库单看板行(全部结果)
    返回 左对齐("入库单", 12) + 右对齐(长度(全部结果), 6) + " 条"
    结束


请 库存_入库单数量表(全部结果)
    定义 列们 = [
    文本列("名称", 18),
    数值列("数量", 10),
    金额列("单价", 14),
    金额列("金额", 16)
    ]
    定义 行们 = []
    遍历 全部结果 中的每个 某记录
        入列(行们, [某记录.名称, 某记录.数量, 某记录.单价,
        库存_入库单金额(某记录)])
    结束
    入列(行们, ["合计", 库存_入库单数量合计(全部结果), 0,
    库存_入库单金额合计(全部结果)])
    返回 造表格("入库单数量汇总", 列们, 行们)
结束


