// ============================================================ 合规域 · 服务
//
// 服务层：**纯函数** —— 只读入参、不改入参、只返回值。
//
// 枢言的赋值是**引用语义**。若服务层随手改入参，调用方持有的对象会被
// 悄悄改掉，跨模块排查极其困难。故这里一律「算出新对象并返回」，
// 状态更新由调用方整体替换。

引入 "合规/模型"
引入 { 本域状态, 制度文件, 内控要点, 风险评估, 审计计划, 审计发现, 整改跟踪 } 从 "合规/模型"
引入 { 合规检查, 违规记录, 授权台账, 证照档案, 风险预警, 合规台账 } 从 "合规/模型"
引入 { 合并校验, 日期加天, 相差天数, 要求非空, 要求非负, 账龄名, 账龄桶 } 从 "框架/基础"


// ============================================================ 制度文件

// 校验：返回 [是否通过, 说明]
请 合规_制度文件校验(某记录)
    定义 结果表 = [
    要求非空(某记录.编号, "编号"),
    要求非空(某记录.名称, "名称")
    ]
    返回 合并校验(结果表)
结束


请 合规_制度文件启用数(全部结果)
    定义 合计 = 0
    遍历 全部结果 中的每个 某记录
        如果 某记录.启用 则
            合计 = 合计 + 1
        结束
    结束
    返回 合计
结束

请 合规_制度文件按分类(全部结果, 分类)
    定义 结果 = []
    遍历 全部结果 中的每个 某记录
        如果 某记录.分类 是 分类 则
            入列(结果, 某记录)
        结束
    结束
    返回 结果
结束

请 合规_制度文件分类分布(全部结果)
    定义 结果 = {}
    遍历 全部结果 中的每个 某记录
        定义 键 = 某记录.分类
        如果 非 有键(结果, 键) 则
            结果[键] = 0
        结束
        结果[键] = 结果[键] + 1
    结束
    返回 结果
结束

请 合规_制度文件启用率(全部结果)
    如果 长度(全部结果) 是 0 则
        返回 0
    结束
    返回 数学.向下取整(合规_制度文件启用数(全部结果) * 100 / 长度(全部结果))
结束


// ============================================================ 内控要点

// 校验：返回 [是否通过, 说明]
请 合规_内控要点校验(某记录)
    定义 结果表 = [
    要求非空(某记录.编号, "编号"),
    要求非空(某记录.名称, "名称")
    ]
    返回 合并校验(结果表)
结束


请 合规_内控要点层级校验(某记录)
    定义 结果表 = [
    要求非负(某记录.层级, "层级"),
    要求非负(某记录.排序号, "排序号")
    ]
    返回 合并校验(结果表)
结束

// 直接子节点
请 合规_内控要点子节点(全部结果, 上级编号)
    定义 结果 = []
    遍历 全部结果 中的每个 某记录
        如果 某记录.上级编号 是 上级编号 则
            入列(结果, 某记录)
        结束
    结束
    返回 排序依据(结果, 合规_内控要点取排序号)
结束

请 合规_内控要点取排序号(某记录)
    返回 某记录.排序号
结束

// 子树全部节点（广度优先）
请 合规_内控要点子树(全部结果, 起点编号)
    定义 结果 = []
    定义 待办 = [起点编号]
    当 长度(待办) > 0 成立
        定义 当前 = 待办[0]
        定义 剩余 = 切片(待办, 1)
        待办 = 剩余
        定义 孩子们 = 合规_内控要点子节点(全部结果, 当前)
        遍历 孩子们 中的每个 某记录
            入列(结果, 某记录)
            入列(待办, 某记录.编号)
        结束
    结束
    返回 结果
结束

请 合规_内控要点最大深度(全部结果)
    定义 最大层 = 0
    遍历 全部结果 中的每个 某记录
        如果 某记录.层级 > 最大层 则
            最大层 = 某记录.层级
        结束
    结束
    返回 最大层
结束

// 按层级分组计数
请 合规_内控要点层级分布(全部结果)
    定义 结果 = {}
    遍历 全部结果 中的每个 某记录
        定义 键 = "第 " + 转文本(某记录.层级) + " 层"
        如果 非 有键(结果, 键) 则
            结果[键] = 0
        结束
        结果[键] = 结果[键] + 1
    结束
    返回 结果
结束


// ============================================================ 风险评估

// 校验：返回 [是否通过, 说明]
请 合规_风险评估校验(某记录)
    定义 结果表 = [
    要求非空(某记录.编号, "编号"),
    要求非空(某记录.名称, "名称")
    ]
    返回 合并校验(结果表)
结束


// 状态机：允许的流转（唯一判据，不在别处再写一遍）
请 合规_风险评估可流转(当前, 目标)
    如果 当前 是 本域状态.草稿 则
        返回 目标 是 本域状态.已提交
    结束
    如果 当前 是 本域状态.已提交 则
        返回 目标 是 本域状态.已审批 或 目标 是 本域状态.已作废
    结束
    如果 当前 是 本域状态.已审批 则
        返回 目标 是 本域状态.已执行
    结束
    如果 当前 是 本域状态.已执行 则
        返回 目标 是 本域状态.已完成
    结束
    返回 假
结束

请 合规_风险评估推进(某记录, 目标)
    如果 非 合规_风险评估可流转(某记录.状态, 目标) 则
        返回 [某记录, "不能从「" + 某记录.状态.名称 + "」流转到「" +
            目标.名称 + "」"]
    结束
    定义 新记录 = 风险评估(编号 是 某记录.编号, 名称 是 某记录.名称,
    状态 是 目标, 主责人 是 某记录.主责人, 建立日期 是 某记录.建立日期,
    单据状态 是 某记录.单据状态, 优先级 是 某记录.优先级, 轮数 是 某记录.轮数)
    返回 [新记录, "已流转到「" + 目标.名称 + "」"]
结束

请 合规_风险评估轮数合计(全部结果)
    定义 合计 = 0
    遍历 全部结果 中的每个 某记录
        合计 = 合计 + 某记录.轮数
    结束
    返回 合计
结束

请 合规_风险评估优先级合计(全部结果)
    定义 合计 = 0
    遍历 全部结果 中的每个 某记录
        合计 = 合计 + 某记录.优先级
    结束
    返回 合计
结束

请 合规_风险评估高优先(全部结果, 阈值)
    定义 结果 = []
    遍历 全部结果 中的每个 某记录
        如果 某记录.优先级 >= 阈值 则
            入列(结果, 某记录)
        结束
    结束
    返回 结果
结束


// ============================================================ 审计计划

// 校验：返回 [是否通过, 说明]
请 合规_审计计划校验(某记录)
    定义 结果表 = [
    要求非空(某记录.编号, "编号"),
    要求非空(某记录.名称, "名称")
    ]
    返回 合并校验(结果表)
结束


请 合规_审计计划日期校验(某记录)
    定义 结果表 = [
    要求非空(某记录.发生日期, "发生日期"),
    要求非负(某记录.账期天数, "账期天数")
    ]
    返回 合并校验(结果表)
结束

// 到期日 = 发生日 + 账期
请 合规_审计计划到期日(某记录)
    返回 日期加天(某记录.发生日期, 某记录.账期天数)
结束

// 逾期天数 = 基准日 - 到期日（未逾期返回 0）
请 合规_审计计划逾期天数(某记录, 基准日)
    定义 差 = 相差天数(合规_审计计划到期日(某记录), 基准日)
    如果 差 < 0 则
        返回 0
    结束
    返回 差
结束

请 合规_审计计划已逾期(某记录, 基准日)
    返回 合规_审计计划逾期天数(某记录, 基准日) > 0
结束

请 合规_审计计划账龄桶(某记录, 基准日)
    返回 账龄桶(合规_审计计划逾期天数(某记录, 基准日))
结束

请 合规_审计计划按桶统计(全部结果, 基准日)
    定义 结果 = {}
    定义 序号 = 1
    当 序号 <= 4 成立
        结果[账龄名(序号)] = 0
        序号 = 序号 + 1
    结束
    遍历 全部结果 中的每个 某记录
        定义 键 = 账龄名(合规_审计计划账龄桶(某记录, 基准日))
        结果[键] = 结果[键] + 1
    结束
    返回 结果
结束

请 合规_审计计划逾期清单(全部结果, 基准日)
    定义 结果 = []
    遍历 全部结果 中的每个 某记录
        如果 合规_审计计划已逾期(某记录, 基准日) 则
            入列(结果, 某记录)
        结束
    结束
    返回 排序依据(结果, 合规_审计计划取逾期天数键, 真)
结束

请 合规_审计计划取逾期天数键(某记录)
    返回 某记录.逾期天数
结束


// ============================================================ 审计发现

// 校验：返回 [是否通过, 说明]
请 合规_审计发现校验(某记录)
    定义 结果表 = [
    要求非空(某记录.编号, "编号"),
    要求非空(某记录.名称, "名称")
    ]
    返回 合并校验(结果表)
结束


// 状态机：允许的流转（唯一判据，不在别处再写一遍）
请 合规_审计发现可流转(当前, 目标)
    如果 当前 是 本域状态.草稿 则
        返回 目标 是 本域状态.已提交
    结束
    如果 当前 是 本域状态.已提交 则
        返回 目标 是 本域状态.已审批 或 目标 是 本域状态.已作废
    结束
    如果 当前 是 本域状态.已审批 则
        返回 目标 是 本域状态.已执行
    结束
    如果 当前 是 本域状态.已执行 则
        返回 目标 是 本域状态.已完成
    结束
    返回 假
结束

请 合规_审计发现推进(某记录, 目标)
    如果 非 合规_审计发现可流转(某记录.状态, 目标) 则
        返回 [某记录, "不能从「" + 某记录.状态.名称 + "」流转到「" +
            目标.名称 + "」"]
    结束
    定义 新记录 = 审计发现(编号 是 某记录.编号, 名称 是 某记录.名称,
    状态 是 目标, 主责人 是 某记录.主责人, 建立日期 是 某记录.建立日期,
    单据状态 是 某记录.单据状态, 优先级 是 某记录.优先级, 轮数 是 某记录.轮数)
    返回 [新记录, "已流转到「" + 目标.名称 + "」"]
结束

请 合规_审计发现轮数合计(全部结果)
    定义 合计 = 0
    遍历 全部结果 中的每个 某记录
        合计 = 合计 + 某记录.轮数
    结束
    返回 合计
结束

请 合规_审计发现优先级合计(全部结果)
    定义 合计 = 0
    遍历 全部结果 中的每个 某记录
        合计 = 合计 + 某记录.优先级
    结束
    返回 合计
结束

请 合规_审计发现高优先(全部结果, 阈值)
    定义 结果 = []
    遍历 全部结果 中的每个 某记录
        如果 某记录.优先级 >= 阈值 则
            入列(结果, 某记录)
        结束
    结束
    返回 结果
结束


// ============================================================ 整改跟踪

// 校验：返回 [是否通过, 说明]
请 合规_整改跟踪校验(某记录)
    定义 结果表 = [
    要求非空(某记录.编号, "编号"),
    要求非空(某记录.名称, "名称")
    ]
    返回 合并校验(结果表)
结束


// 状态机：允许的流转（唯一判据，不在别处再写一遍）
请 合规_整改跟踪可流转(当前, 目标)
    如果 当前 是 本域状态.草稿 则
        返回 目标 是 本域状态.已提交
    结束
    如果 当前 是 本域状态.已提交 则
        返回 目标 是 本域状态.已审批 或 目标 是 本域状态.已作废
    结束
    如果 当前 是 本域状态.已审批 则
        返回 目标 是 本域状态.已执行
    结束
    如果 当前 是 本域状态.已执行 则
        返回 目标 是 本域状态.已完成
    结束
    返回 假
结束

请 合规_整改跟踪推进(某记录, 目标)
    如果 非 合规_整改跟踪可流转(某记录.状态, 目标) 则
        返回 [某记录, "不能从「" + 某记录.状态.名称 + "」流转到「" +
            目标.名称 + "」"]
    结束
    定义 新记录 = 整改跟踪(编号 是 某记录.编号, 名称 是 某记录.名称,
    状态 是 目标, 主责人 是 某记录.主责人, 建立日期 是 某记录.建立日期,
    单据状态 是 某记录.单据状态, 优先级 是 某记录.优先级, 轮数 是 某记录.轮数)
    返回 [新记录, "已流转到「" + 目标.名称 + "」"]
结束

请 合规_整改跟踪轮数合计(全部结果)
    定义 合计 = 0
    遍历 全部结果 中的每个 某记录
        合计 = 合计 + 某记录.轮数
    结束
    返回 合计
结束

请 合规_整改跟踪优先级合计(全部结果)
    定义 合计 = 0
    遍历 全部结果 中的每个 某记录
        合计 = 合计 + 某记录.优先级
    结束
    返回 合计
结束

请 合规_整改跟踪高优先(全部结果, 阈值)
    定义 结果 = []
    遍历 全部结果 中的每个 某记录
        如果 某记录.优先级 >= 阈值 则
            入列(结果, 某记录)
        结束
    结束
    返回 结果
结束


