// ============================================================ 里程碑

// 校验：返回 [是否通过, 说明]
请 项目_里程碑校验(某记录)
    定义 结果表 = [
    要求非空(某记录.编号, "编号"),
    要求非空(某记录.名称, "名称")
    ]
    返回 合并校验(结果表)
结束


请 项目_里程碑日期校验(某记录)
    定义 结果表 = [
    要求非空(某记录.发生日期, "发生日期"),
    要求非负(某记录.账期天数, "账期天数")
    ]
    返回 合并校验(结果表)
结束

// 到期日 = 发生日 + 账期
请 项目_里程碑到期日(某记录)
    返回 日期加天(某记录.发生日期, 某记录.账期天数)
结束

// 逾期天数 = 基准日 - 到期日（未逾期返回 0）
请 项目_里程碑逾期天数(某记录, 基准日)
    定义 差 = 相差天数(项目_里程碑到期日(某记录), 基准日)
    如果 差 < 0 则
        返回 0
    结束
    返回 差
结束

请 项目_里程碑已逾期(某记录, 基准日)
    返回 项目_里程碑逾期天数(某记录, 基准日) > 0
结束

请 项目_里程碑账龄桶(某记录, 基准日)
    返回 账龄桶(项目_里程碑逾期天数(某记录, 基准日))
结束

请 项目_里程碑按桶统计(全部结果, 基准日)
    定义 结果 = {}
    定义 序号 = 1
    当 序号 <= 4 成立
        结果[账龄名(序号)] = 0
        序号 = 序号 + 1
    结束
    遍历 全部结果 中的每个 某记录
        定义 键 = 账龄名(项目_里程碑账龄桶(某记录, 基准日))
        结果[键] = 结果[键] + 1
    结束
    返回 结果
结束

请 项目_里程碑逾期清单(全部结果, 基准日)
    定义 结果 = []
    遍历 全部结果 中的每个 某记录
        如果 项目_里程碑已逾期(某记录, 基准日) 则
            入列(结果, 某记录)
        结束
    结束
    返回 排序依据(结果, 项目_里程碑取逾期天数键, 真)
结束

请 项目_里程碑取逾期天数键(某记录)
    返回 某记录.逾期天数
结束


// ============================================================ 项目成员

// 校验：返回 [是否通过, 说明]
请 项目_项目成员校验(某记录)
    定义 结果表 = [
    要求非空(某记录.编号, "编号"),
    要求非空(某记录.名称, "名称")
    ]
    返回 合并校验(结果表)
结束


请 项目_项目成员启用数(全部结果)
    定义 合计 = 0
    遍历 全部结果 中的每个 某记录
        如果 某记录.启用 则
            合计 = 合计 + 1
        结束
    结束
    返回 合计
结束

请 项目_项目成员按分类(全部结果, 分类)
    定义 结果 = []
    遍历 全部结果 中的每个 某记录
        如果 某记录.分类 是 分类 则
            入列(结果, 某记录)
        结束
    结束
    返回 结果
结束

请 项目_项目成员分类分布(全部结果)
    定义 结果 = {}
    遍历 全部结果 中的每个 某记录
        定义 键 = 某记录.分类
        如果 非 有键(结果, 键) 则
            结果[键] = 0
        结束
        结果[键] = 结果[键] + 1
    结束
    返回 结果
结束

请 项目_项目成员启用率(全部结果)
    如果 长度(全部结果) 是 0 则
        返回 0
    结束
    返回 数学.向下取整(项目_项目成员启用数(全部结果) * 100 / 长度(全部结果))
结束


