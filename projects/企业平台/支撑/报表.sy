// ============================================================ 支撑域 · 报表
//
// 报表层：只做**呈现**，不含业务判定。
// 表格一律经 `框架/报表` 渲染 —— 列宽与对齐规则只有一份。

引入 "框架/报表"
引入 "支撑/模型"
引入 "支撑/服务"
引入 { 支撑_审计日志到期日, 支撑_审计日志按桶统计, 支撑_审计日志账龄桶 } 从 "支撑/服务"
引入 { 支撑_审计日志逾期天数, 支撑_接口日志到期日, 支撑_接口日志按桶统计 } 从 "支撑/服务"
引入 { 支撑_接口日志账龄桶, 支撑_接口日志逾期天数 } 从 "支撑/服务"
引入 { 右对齐, 左对齐, 账龄名 } 从 "框架/基础"
引入 { 数值列, 文本列, 造表格 } 从 "框架/报表"


// ------------------------------------------------------------ 审批流程 报表

请 支撑_审批流程明细表(全部结果)
    定义 列们 = [
    文本列("编号", 14),
    文本列("名称", 18),
    文本列("状态", 8),
    文本列("主责人", 10),
    文本列("建立日期", 12)
    ]
    定义 行们 = []
    遍历 全部结果 中的每个 某记录
        入列(行们, [某记录.编号, 某记录.名称, 某记录.状态.名称,
        某记录.主责人, 某记录.建立日期])
    结束
    返回 造表格("审批流程明细", 列们, 行们)
结束

请 支撑_审批流程状态汇总(全部结果)
    定义 分布 = {}
    遍历 全部结果 中的每个 某记录
        定义 键 = 某记录.状态.名称
        如果 非 有键(分布, 键) 则
            分布[键] = 0
        结束
        分布[键] = 分布[键] + 1
    结束
    定义 列们 = [文本列("状态", 12), 数值列("条数", 8)]
    定义 行们 = []
    遍历 取键(分布) 中的每个 某键
        入列(行们, [某键, 分布[某键]])
    结束
    入列(行们, ["合计", 长度(全部结果)])
    返回 造表格("审批流程状态分布", 列们, 行们)
结束

请 支撑_审批流程看板行(全部结果)
    返回 左对齐("审批流程", 12) + 右对齐(长度(全部结果), 6) + " 条"
    结束


