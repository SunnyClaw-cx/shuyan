请 支撑_审计日志账龄表(全部结果, 基准日)
    定义 列们 = [
    文本列("编号", 14),
    文本列("到期日", 12),
    数值列("逾期天数", 10),
    文本列("账龄", 12)
    ]
    定义 行们 = []
    遍历 全部结果 中的每个 某记录
        定义 桶 = 支撑_审计日志账龄桶(某记录, 基准日)
        入列(行们, [某记录.编号, 支撑_审计日志到期日(某记录),
        支撑_审计日志逾期天数(某记录, 基准日), 账龄名(桶)])
    结束
    返回 造表格("审计日志账龄分析", 列们, 行们)
结束

请 支撑_审计日志桶汇总(全部结果, 基准日)
    定义 分布 = 支撑_审计日志按桶统计(全部结果, 基准日)
    定义 列们 = [文本列("账龄", 12), 数值列("条数", 8)]
    定义 行们 = []
    遍历 取键(分布) 中的每个 某键
        入列(行们, [某键, 分布[某键]])
    结束
    返回 造表格("审计日志账龄分布", 列们, 行们)
结束


