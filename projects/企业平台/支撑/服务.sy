// ============================================================ 支撑域 · 服务
//
// 服务层：**纯函数** —— 只读入参、不改入参、只返回值。
//
// 枢言的赋值是**引用语义**。若服务层随手改入参，调用方持有的对象会被
// 悄悄改掉，跨模块排查极其困难。故这里一律「算出新对象并返回」，
// 状态更新由调用方整体替换。

引入 "支撑/模型"
引入 { 本域状态, 审批流程, 审批节点, 权限角色, 权限矩阵, 审计日志, 系统通知 } 从 "支撑/模型"
引入 { 附件档案, 数据字典, 编号规则, 接口日志, 定时任务, 配置项 } 从 "支撑/模型"
引入 { 合并校验, 日期加天, 相差天数, 要求非空, 要求非负, 账龄名, 账龄桶 } 从 "框架/基础"


// ============================================================ 审批流程

// 校验：返回 [是否通过, 说明]
请 支撑_审批流程校验(某记录)
    定义 结果表 = [
    要求非空(某记录.编号, "编号"),
    要求非空(某记录.名称, "名称")
    ]
    返回 合并校验(结果表)
结束


// 状态机：允许的流转（唯一判据，不在别处再写一遍）
请 支撑_审批流程可流转(当前, 目标)
    如果 当前 是 本域状态.草稿 则
        返回 目标 是 本域状态.已提交
    结束
    如果 当前 是 本域状态.已提交 则
        返回 目标 是 本域状态.已审批 或 目标 是 本域状态.已作废
    结束
    如果 当前 是 本域状态.已审批 则
        返回 目标 是 本域状态.已执行
    结束
    如果 当前 是 本域状态.已执行 则
        返回 目标 是 本域状态.已完成
    结束
    返回 假
结束

请 支撑_审批流程推进(某记录, 目标)
    如果 非 支撑_审批流程可流转(某记录.状态, 目标) 则
        返回 [某记录, "不能从「" + 某记录.状态.名称 + "」流转到「" +
            目标.名称 + "」"]
    结束
    定义 新记录 = 审批流程(编号 是 某记录.编号, 名称 是 某记录.名称,
    状态 是 目标, 主责人 是 某记录.主责人, 建立日期 是 某记录.建立日期,
    单据状态 是 某记录.单据状态, 优先级 是 某记录.优先级, 轮数 是 某记录.轮数)
    返回 [新记录, "已流转到「" + 目标.名称 + "」"]
结束

请 支撑_审批流程轮数合计(全部结果)
    定义 合计 = 0
    遍历 全部结果 中的每个 某记录
        合计 = 合计 + 某记录.轮数
    结束
    返回 合计
结束

请 支撑_审批流程优先级合计(全部结果)
    定义 合计 = 0
    遍历 全部结果 中的每个 某记录
        合计 = 合计 + 某记录.优先级
    结束
    返回 合计
结束

请 支撑_审批流程高优先(全部结果, 阈值)
    定义 结果 = []
    遍历 全部结果 中的每个 某记录
        如果 某记录.优先级 >= 阈值 则
            入列(结果, 某记录)
        结束
    结束
    返回 结果
结束


// ============================================================ 审批节点

// 校验：返回 [是否通过, 说明]
请 支撑_审批节点校验(某记录)
    定义 结果表 = [
    要求非空(某记录.编号, "编号"),
    要求非空(某记录.名称, "名称")
    ]
    返回 合并校验(结果表)
结束


请 支撑_审批节点层级校验(某记录)
    定义 结果表 = [
    要求非负(某记录.层级, "层级"),
    要求非负(某记录.排序号, "排序号")
    ]
    返回 合并校验(结果表)
结束

// 直接子节点
请 支撑_审批节点子节点(全部结果, 上级编号)
    定义 结果 = []
    遍历 全部结果 中的每个 某记录
        如果 某记录.上级编号 是 上级编号 则
            入列(结果, 某记录)
        结束
    结束
    返回 排序依据(结果, 支撑_审批节点取排序号)
结束

请 支撑_审批节点取排序号(某记录)
    返回 某记录.排序号
结束

// 子树全部节点（广度优先）
请 支撑_审批节点子树(全部结果, 起点编号)
    定义 结果 = []
    定义 待办 = [起点编号]
    当 长度(待办) > 0 成立
        定义 当前 = 待办[0]
        定义 剩余 = 切片(待办, 1)
        待办 = 剩余
        定义 孩子们 = 支撑_审批节点子节点(全部结果, 当前)
        遍历 孩子们 中的每个 某记录
            入列(结果, 某记录)
            入列(待办, 某记录.编号)
        结束
    结束
    返回 结果
结束

请 支撑_审批节点最大深度(全部结果)
    定义 最大层 = 0
    遍历 全部结果 中的每个 某记录
        如果 某记录.层级 > 最大层 则
            最大层 = 某记录.层级
        结束
    结束
    返回 最大层
结束

// 按层级分组计数
请 支撑_审批节点层级分布(全部结果)
    定义 结果 = {}
    遍历 全部结果 中的每个 某记录
        定义 键 = "第 " + 转文本(某记录.层级) + " 层"
        如果 非 有键(结果, 键) 则
            结果[键] = 0
        结束
        结果[键] = 结果[键] + 1
    结束
    返回 结果
结束


// ============================================================ 权限角色

// 校验：返回 [是否通过, 说明]
请 支撑_权限角色校验(某记录)
    定义 结果表 = [
    要求非空(某记录.编号, "编号"),
    要求非空(某记录.名称, "名称")
    ]
    返回 合并校验(结果表)
结束


请 支撑_权限角色启用数(全部结果)
    定义 合计 = 0
    遍历 全部结果 中的每个 某记录
        如果 某记录.启用 则
            合计 = 合计 + 1
        结束
    结束
    返回 合计
结束

请 支撑_权限角色按分类(全部结果, 分类)
    定义 结果 = []
    遍历 全部结果 中的每个 某记录
        如果 某记录.分类 是 分类 则
            入列(结果, 某记录)
        结束
    结束
    返回 结果
结束

请 支撑_权限角色分类分布(全部结果)
    定义 结果 = {}
    遍历 全部结果 中的每个 某记录
        定义 键 = 某记录.分类
        如果 非 有键(结果, 键) 则
            结果[键] = 0
        结束
        结果[键] = 结果[键] + 1
    结束
    返回 结果
结束

请 支撑_权限角色启用率(全部结果)
    如果 长度(全部结果) 是 0 则
        返回 0
    结束
    返回 数学.向下取整(支撑_权限角色启用数(全部结果) * 100 / 长度(全部结果))
结束


