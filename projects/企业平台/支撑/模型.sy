// ============================================================ 支撑域 · 模型
//
// 审批流、权限、审计、通知、附件与数据字典。
//
// 本文件只放**类型定义与构造辅助**，不含任何业务逻辑。
// 类型的字段顺序只在这里维护一次：字段增删只改本文件，
// 业务代码不受影响（它们一律走构造辅助）。

// 模型层只用内置函数，不依赖框架/基础 —— 保持最底层零依赖。

// ------------------------------------------------------------ 本域状态枚举

类型 本域状态 = { 草稿, 已提交, 已审批, 已执行, 已完成, 已作废 }


// ------------------------------------------------------------ 审批流程

类型 审批流程 = {
    编号: 文本,
    名称: 文本,
    状态: 本域状态,
    主责人: 文本,
    建立日期: 文本,
    单据状态: 文本,
    优先级: 整数,
    轮数: 整数,
}

// ------------------------------------------------------------ 审批节点

类型 审批节点 = {
    编号: 文本,
    名称: 文本,
    状态: 本域状态,
    主责人: 文本,
    建立日期: 文本,
    上级编号: 文本,
    层级: 整数,
    排序号: 整数,
}

// ------------------------------------------------------------ 权限角色

