// 库存管理 · 主程序
//
// 这是一个**多文件工程**的最小完整示例，演示四件事：
//   ① 类型集中定义（领域模型.sy）—— 一处定义、处处一致
//   ② 业务逻辑独立成模块（库存服务.sy）—— 与界面解耦
//   ③ 枚举表达领域状态，结构体表达领域数据
//   ④ 模块里的构造器可跨文件调用（`领域模型.造物料(...)`）
//
// 运行：sy 运行 projects/库存管理/主程序.sy
//
// 注：路径相对于**主脚本所在目录**，故在仓库根目录运行也可。

引入 "领域模型"
引入 "库存服务"

// ------------------------------------------------------------ 初始化数据

定义 全部物料 = [
领域模型.造物料("M-1001", "螺纹钢", 领域模型.类别.原料, 4200.0),
领域模型.造物料("M-1002", "铝合金板", 领域模型.类别.原料, 18500.0),
领域模型.造物料("M-2001", "齿轮组件", 领域模型.类别.半成品, 860.0),
领域模型.造物料("M-3001", "减速机", 领域模型.类别.成品, 3200.0),
领域模型.造物料("M-4001", "轴承", 领域模型.类别.备件, 95.5)
]

输出("════════════════════════════════════════")
输出(" 库存管理系统 · 枢言样例工程")
输出("════════════════════════════════════════")

// ------------------------------------------------------------ 入库

输出("")
输出("【第一步】入库作业")

定义 入库单 = [
领域模型.造流水("RK-0001", "M-1001", 领域模型.方向.入库, 120,
领域模型.单据状态.已完成),
领域模型.造流水("RK-0002", "M-1002", 领域模型.方向.入库, 35,
领域模型.单据状态.已完成),
领域模型.造流水("RK-0003", "M-2001", 领域模型.方向.入库, 200,
领域模型.单据状态.已完成),
领域模型.造流水("RK-0004", "M-3001", 领域模型.方向.入库, 18,
领域模型.单据状态.`处理中`)
]

遍历 入库单 中的每个 某单据
    定义 结果 = 库存服务.处理流水(全部物料, 某单据)
    // 结果是一个 [是否成功, 说明] 两元素列表
    如果 结果[0] 则
        输出(" ✓ " + 某单据.单号 + "：" + 结果[1])
    否则
        输出(" · " + 某单据.单号 + "：" + 结果[1])
    结束
结束

// ------------------------------------------------------------ 出库

输出("")
输出("【第二步】出库作业")

定义 出库单 = [
领域模型.造流水("CK-0001", "M-1001", 领域模型.方向.出库, 45,
领域模型.单据状态.已完成),
领域模型.造流水("CK-0002", "M-2001", 领域模型.方向.出库, 60,
领域模型.单据状态.已完成),
// 这条是**库存不足**，业务上必须被拦下
领域模型.造流水("CK-0003", "M-4001", 领域模型.方向.出库, 50,
领域模型.单据状态.已完成),
// 这条状态未完成，库存不该变动
领域模型.造流水("CK-0004", "M-3001", 领域模型.方向.出库, 5,
领域模型.单据状态.待审核)
]

遍历 出库单 中的每个 某单据
    定义 结果 = 库存服务.处理流水(全部物料, 某单据)
    如果 结果[0] 则
        输出(" ✓ " + 某单据.单号 + "：" + 结果[1])
    否则
        输出(" ⚠ " + 某单据.单号 + "：" + 结果[1])
    结束
结束

// 再补一笔入库 + 出库，把备件库存建立起来
定义 补入 = 领域模型.造流水("RK-0005", "M-4001",
领域模型.方向.入库, 100,
领域模型.单据状态.已完成)
定义 补入结果 = 库存服务.处理流水(全部物料, 补入)
输出(" ✓ " + 补入.单号 + "：" + 补入结果[1])

// ------------------------------------------------------------ 报表

输出("")
输出("【第三步】库存现状")
库存服务.显示全部(全部物料)

// ------------------------------------------------------------ 按类别统计

输出("")
输出("【第四步】按类别汇总")

定义 各类别 = [领域模型.类别.原料, 领域模型.类别.半成品,
领域模型.类别.成品, 领域模型.类别.备件]

遍历 各类别 中的每个 某个类别
    定义 该类的 = 库存服务.按类别筛选(全部物料, 某个类别)
    定义 总数量 = 0
    定义 总价值 = 0.0
    遍历 该类的 中的每个 某个物料
        总数量 = 总数量 + 某个物料.库存
        总价值 = 总价值 + 某个物料.库存 * 某个物料.单价
    结束
    输出(" " + 文本.填充(某个类别.名称, 10)
    + "种类 " + 转文本(长度(该类的))
    + "，数量 " + 转文本(总数量)
    + "，价值 " + 转文本(总价值))
结束

// ------------------------------------------------------------ 预警

输出("")
输出("【第五步】低库存预警（阈值 50）")

定义 需要补货 = 库存服务.低库存预警(全部物料, 50)
如果 长度(需要补货) 等于 0 则
    输出(" 暂无需要补货的物料")
否则
    遍历 需要补货 中的每个 某个物料
        输出(" ⚠ " + 某个物料.名称 + "（" + 某个物料.编码
        + "）现存 " + 转文本(某个物料.库存)
        + "，低于阈值 50")
    结束
结束

// ------------------------------------------------------------ 导出

输出("")
输出("【第六步】导出 CSV")

定义 文本报告 = 库存服务.导出CSV(全部物料)
输出(文本报告)

// 落盘（写到脚本所在目录）
定义 输出文件 = 文件.路径合并(系统.当前目录(), "库存导出.csv")
文件.写文本(输出文件, 文本报告)
输出("")
输出("已导出到：" + 输出文件)

输出("")
输出("════════════════════════════════════════")
输出(" 演示结束")
输出("════════════════════════════════════════")
