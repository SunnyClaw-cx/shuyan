// 领域模型：库存管理用到的全部数据类型
//
// 这是样例工程的**类型中枢**：其余文件从这里引入类型，
// 保证「一处定义、处处一致」——改字段只需改这一个文件。

// 物料类别
类型 类别 = { 原料, 半成品, 成品, 备件 }

// 出入库方向
类型 方向 = { 入库, 出库 }

// 单据状态（`处理中` 会被词法切成 `处理`+`中`，故用反引号整体保留）
类型 单据状态 = { 草稿, 待审核, `处理中`, 已完成, 已作废 }

// 一条物料记录
类型 物料 = {
编码: 文本,
名称: 文本,
类别: 类别,
单价: 小数,
库存: 整数
}

// 一条出入库流水
类型 流水 = {
单号: 文本,
物料编码: 文本,
方向: 方向,
数量: 整数,
状态: 单据状态
}

// 构造一条物料（默认库存为 0）
// 参数用 `物料编码值` 而非 `编码` —— 后者与内置模块 `编码` 同名，
// 一旦函数体里要写 `编码.某成员` 就会被挡住（`sy 检查` 的 W4001 会提醒）。
请 造物料(物料编码值, 名称, 类别, 单价)
    返回 物料(编码 是 物料编码值, 名称 是 名称, 类别 是 类别,
    单价 是 单价, 库存 是 0)
结束

// 构造一条流水
请 造流水(单号, 物料编码, 方向, 数量, 状态)
    返回 流水(单号 是 单号, 物料编码 是 物料编码, 方向 是 方向,
    数量 是 数量, 状态 是 状态)
结束
