// 枢言 Web 应用示例 —— 一个前后端齐全的留言板
//
// 验证目标：枢言能否承载一个完整 Web 应用的业务逻辑？
//
//   ┌─────────────┐    HTTP     ┌──────────────────┐
//   │  浏览器      │ ──────────▶ │  网络适配层       │   ← 宿主提供（约 127 行）
//   │  （前端页面） │ ◀────────── │  （监听/解析/回写）│
//   └─────────────┘             └────────┬─────────┘
//                                        │ 调用
//                                        ▼
//                               ┌──────────────────┐
//                               │  业务逻辑（本文件）│   ← 枢言编写
//                               │  路由 / 状态码 /   │
//                               │  渲染 / 数据处理   │
//                               └──────────────────┘
//
// 要点：**枢言负责"算什么"，宿主只负责"怎么收发"**。
// 路由分发、状态码决策、HTML 渲染、数据增删 —— 全部在枢言里完成。
//
// 运行：python projects/留言板/服务.py
//      然后浏览器打开 http://127.0.0.1:8000

// ============================================================ 领域模型

类型 留言 = { 姓名: 文本, 内容: 文本, 时间: 文本 }

// ============================================================ 数据层
//
// 说明：此处用内存列表保存。持久化可换成 `文件.写文本` 存 JSON 文本，
// 标准库的 `文件` 模块已具备该能力。

定义 全部留言 = []

请 新增留言(姓名, 内容)
    定义 一条 = 留言(姓名 是 姓名, 内容 是 内容, 时间 是 时间.现在())
    入列(全部留言, 一条)
    返回 一条
结束

请 统计数量()
    返回 长度(全部留言)
结束

// ============================================================ 视图层（渲染 HTML）
//
// 长字符串拼接用**圆括号续行**：括号内换行不会被当作语句结束。

请 渲染首页()
    定义 条目 = ""
    遍历 全部留言 中的每个 某条
        条目 = 条目 + "    <li><strong>" + 某条.姓名 + "</strong>" +
            " <span class='时间'>" + 某条.时间 + "</span>" +
            "<p>" + 某条.内容 + "</p></li>"
    结束

    如果 长度(全部留言) 等于 0 则
        条目 = "    <li class='空'>还没有留言，来说点什么吧。</li>"
    结束

    返回 ("<!DOCTYPE html>" +
        "<html lang='zh'><head><meta charset='utf-8'>" +
        "<meta name='viewport' content='width=device-width,initial-scale=1'>" +
        "<title>留言板</title>" +
        "<style>" +
        "body{font-family:system-ui,sans-serif;max-width:640px;margin:40px auto;" +
        "padding:0 20px;color:#2C2C2A}" +
        "h1{font-size:20px;font-weight:500}" +
        "form{display:flex;gap:8px;margin:20px 0;flex-wrap:wrap}" +
        "input,button{font:inherit;padding:8px 10px;border:1px solid #ccc;" +
        "border-radius:6px}" +
        "input[name=name]{width:120px}input[name=text]{flex:1;min-width:180px}" +
        "button{background:#534AB7;color:#fff;border-color:#534AB7;cursor:pointer}" +
        "ul{list-style:none;padding:0}li{border-bottom:1px solid #eee;padding:12px 0}" +
        ".时间{color:#888780;font-size:12px;margin-left:8px}" +
        "li p{margin:6px 0 0}.空{color:#888780;border:none}" +
        "</style></head><body>" +
        "<h1>留言板</h1>" +
        "<form method='post' action='/新增'>" +
        "<input name='name' placeholder='姓名' required>" +
        "<input name='text' placeholder='说点什么…' required>" +
        "<button>发布</button></form>" +
        "<p>共 " + 转文本(统计数量()) + " 条留言</p>" +
        "<ul>" + 条目 + "</ul>" +
        "</body></html>")
结束

// ============================================================ 路由层
//
// 每个分支返回 {状态, 内容}，由宿主翻译成 HTTP 响应。
// 这就是典型的 MVC 控制器 —— 交给语言来做，比写在宿主里更清晰。

请 处理请求(路径, 表单)
    如果 路径 等于 "/" 则
        返回 { "状态": 200, "内容": 渲染首页() }
    结束

    如果 路径 等于 "/新增" 则
        // 表单字段从映射取；缺字段用空保护
        定义 名字 = "匿名"
        定义 内容 = ""
        如果 有键(表单, "name") 则
            名字 = 表单["name"]
        结束
        如果 有键(表单, "text") 则
            内容 = 表单["text"]
        结束
        如果 长度(去空白(内容)) > 0 则
            新增留言(名字, 内容)
        结束
        // 提交后重定向回首页（PRG 模式，避免刷新重复提交）
        返回 { "状态": 302, "内容": "" }
    结束

    如果 路径 等于 "/留言" 则
        // 返回 JSON 形式的文本（供前端脚本调用）
        定义 项 = []
        遍历 全部留言 中的每个 某条
            入列(项, "{\"姓名\":\"" + 某条.姓名 + "\",\"内容\":\"" + 某条.内容 + "\"}")
        结束
        返回 { "状态": 200, "内容": "[" + 连接(项, ",") + "]" }
    结束

    返回 { "状态": 404, "内容": "找不到 " + 路径 }
结束