// ============================================================ ERP 企业套件 —— 主程序
//
// 六模块分层演示：主数据 → 库存服务 → 采购服务 → 销售服务 → 财务服务 → 企业。
// 走通一条完整的「进货 → 存货 → 销货 → 盘点 → 结账」业务链，
// 并验证四条企业级约束：
//     ① 复式记账恒等式   —— 试算平衡
//     ② 移动加权平均成本 —— 库存金额与总账相符
//     ③ 两阶段提交       —— 失败的单据绝不留半截状态
//     ④ 信用管控         —— 超额发货一律拦截
//
// 数据全部内联构造，不依赖外部文件，便于直接运行验证。

引入 "主数据"
引入 "库存服务"
引入 "采购服务"
引入 "销售服务"
引入 "财务服务"
引入 "企业"

输出("═══ ERP 企业套件 · 演示 ═══")
输出("")

// ============================================================ 一、登记主数据

输出("一、主数据")

企业.登记物料(主数据.造物料("M-1001", "大蒜粉", 主数据.物料类别.成品,
    "箱", 8000, 12000, 50))
企业.登记物料(主数据.造物料("M-1002", "辣椒粉", 主数据.物料类别.成品,
    "箱", 6000, 9500, 30))
企业.登记物料(主数据.造物料("M-1003", "包装纸箱", 主数据.物料类别.包装物,
    "个", 150, 0, 500))

企业.登记单位(主数据.造单位("S-001", "金乡蒜业", 主数据.单位类别.供应商,
    0, 30))
企业.登记单位(主数据.造单位("C-001", "临沂商贸", 主数据.单位类别.客户,
    1000000, 30))

企业.登记科目(主数据.造科目("1001", "库存商品", 主数据.科目类别.资产,
    主数据.借贷方向.借))
企业.登记科目(主数据.造科目("1002", "应收账款", 主数据.科目类别.资产,
    主数据.借贷方向.借))
企业.登记科目(主数据.造科目("2001", "应付账款", 主数据.科目类别.负债,
    主数据.借贷方向.贷))
企业.登记科目(主数据.造科目("3001", "实收资本", 主数据.科目类别.所有者权益,
    主数据.借贷方向.贷))
企业.登记科目(主数据.造科目("5001", "主营业务收入", 主数据.科目类别.损益,
    主数据.借贷方向.贷))
企业.登记科目(主数据.造科目("5401", "主营业务成本", 主数据.科目类别.成本,
    主数据.借贷方向.借))
企业.登记科目(主数据.造科目("5901", "待处理财产损溢", 主数据.科目类别.损益,
    主数据.借贷方向.贷))

输出("  物料 " + 转文本(长度(企业.取物料表())) + " 项 · 单位 "
    + 转文本(长度(企业.取单位表())) + " 家 · 科目 "
    + 转文本(长度(企业.取科目表())) + " 个")
输出("")

// ============================================================ 二、采购与收货

输出("二、采购入库")

定义 采购单号 = 企业.开采购单("S-001", "2026-10-21", [
    采购服务.造采购明细("M-1001", 100, 8000),
    采购服务.造采购明细("M-1002", 50, 6000),
    采购服务.造采购明细("M-1003", 2000, 150)
])
输出("  开单 " + 采购单号 + "，金额 "
    + 主数据.分转元(采购服务.订单金额(企业.找采购单(采购单号))))

定义 审核结果 = 企业.审核采购(采购单号)
输出("  审核：" + 审核结果[1])

// 逐行收货，每行一次两阶段提交
定义 收货1 = 企业.采购收货(采购单号, "M-1001", 100, "2026-10-21")
输出("  " + 收货1[1])
定义 收货2 = 企业.采购收货(采购单号, "M-1002", 50, "2026-10-21")
输出("  " + 收货2[1])
定义 收货3 = 企业.采购收货(采购单号, "M-1003", 2000, "2026-10-21")
输出("  " + 收货3[1])

// 失败路径：超量收货必须被拦下，且不能改动任何状态
定义 败收 = 企业.采购收货(采购单号, "M-1001", 999, "2026-10-21")
输出("  预期失败：" + 败收[1])
输出("")

// ============================================================ 三、库存现状

输出("三、库存台账（移动加权平均）")

遍历 企业.取库存台账() 中的每个 某台账
    输出("  " + 某台账.物料编号
        + "  数量 " + 转文本(某台账.数量)
        + "  金额 " + 主数据.分转元(某台账.金额)
        + "  单位成本 " + 主数据.分转元(
            库存服务.单位成本(某台账, 0)))
结束
输出("  库存总金额 " + 主数据.分转元(
    库存服务.库存总金额(企业.取库存台账())))

// 低库存预警（数量低于安全库存）
定义 低库 = 库存服务.低库存物料(企业.取库存台账(), 企业.取物料表())
输出("  低于安全库存：" + 转文本(长度(低库)) + " 项")
遍历 低库 中的每个 行
    输出("    " + 行[0] + " " + 行[1] + "  现有 " + 转文本(行[2])
        + " / 安全 " + 转文本(行[3]))
结束
输出("")

// ============================================================ 四、销售与发货

输出("四、销售发货（含成本结转与信用校验）")

定义 销售单号 = 企业.开销售单("C-001", "2026-10-22", [
    销售服务.造销售明细("M-1001", 40, 12000),
    销售服务.造销售明细("M-1002", 20, 9500)
])
输出("  开单 " + 销售单号 + "，金额 "
    + 主数据.分转元(销售服务.订单金额(企业.找销售单(销售单号))))

定义 审核销售结果 = 企业.审核销售(销售单号)
输出("  审核：" + 审核销售结果[1])

定义 发货1 = 企业.销售发货(销售单号, "M-1001", 40, "2026-10-22")
输出("  " + 发货1[1])
定义 发货2 = 企业.销售发货(销售单号, "M-1002", 20, "2026-10-22")
输出("  " + 发货2[1])

// 失败路径一：库存不足
定义 败发1 = 企业.销售发货(销售单号, "M-1001", 999, "2026-10-22")
输出("  预期失败（库存不足）：" + 败发1[1])

// 失败路径二：信用超额
定义 大单号 = 企业.开销售单("C-001", "2026-10-23", [
    销售服务.造销售明细("M-1001", 1, 100000000)
])
企业.审核销售(大单号)
定义 败发2 = 企业.销售发货(大单号, "M-1001", 1, "2026-10-23")
输出("  预期失败（信用超额）：" + 败发2[1])
输出("")

// ============================================================ 五、盘点

输出("五、盘点调整")

定义 盘1 = 企业.盘点("M-1003", 1985, "2026-10-23")
输出("  " + 盘1[1])
定义 盘2 = 企业.盘点("M-1002", 30, "2026-10-23")
输出("  " + 盘2[1])
输出("")

// ============================================================ 六、结账与报表

输出("六、期末结账")

定义 账簿 = 企业.取账簿()
定义 科目表 = 企业.取科目表()

// 试算平衡：全账借方合计必须等于全账贷方合计
定义 试算 = 财务服务.试算平衡(账簿, 科目表)
输出("  试算平衡：" + 转文本(试算[0])
    + "  借 " + 主数据.分转元(试算[1])
    + "  贷 " + 主数据.分转元(试算[2]))
输出("  凭证张数 " + 转文本(长度(账簿))
    + " · 库存流水 " + 转文本(长度(企业.取库存流水())) + " 条")

// 按科目列示余额。`科目余额` 返回 [余额方向, 余额金额]，此处只要金额。
输出("")
输出("  科目余额")
遍历 科目表 中的每个 某科目
    定义 余 = 财务服务.科目余额(账簿, 科目表, 某科目.编码)
    输出("    " + 某科目.编码 + " " + 某科目.名称
        + "  " + 主数据.分转元(余[1]))
结束

// 库存金额应与「库存商品」科目余额一致 —— 两套账必须对得上
定义 存货科目 = 财务服务.科目余额(账簿, 科目表, "1001")[1]
定义 库存金额 = 库存服务.库存总金额(企业.取库存台账())
输出("")
输出("  存货核对：库存台账 " + 主数据.分转元(库存金额)
    + "  总账「库存商品」 " + 主数据.分转元(存货科目)
    + "  " + 转文本(库存金额 等于 存货科目))

// 毛利：收入 − 成本。`科目发生额` 返回 [借方, 贷方]。
// 收入类科目余额方向为贷，取发生[1]；成本类为借，取发生[0]。
定义 收入发生 = 财务服务.科目发生额(账簿, "5001")
定义 成本发生 = 财务服务.科目发生额(账簿, "5401")
定义 收入 = 收入发生[1] - 收入发生[0]
定义 成本 = 成本发生[0] - 成本发生[1]
输出("  本期毛利：" + 主数据.分转元(收入 - 成本)
    + "（收入 " + 主数据.分转元(收入)
    + " − 成本 " + 主数据.分转元(成本) + "）")
输出("")
输出("═══ 演示结束 ═══")