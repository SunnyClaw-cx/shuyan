// ============================================================ 采购服务
//
// 职责：采购订单的**纯计算**与收货校验。
//
// 业务流程（两阶段，制造业 ERP 的标准做法）：
//   ① 下单：录入明细 → 审核（状态 草稿 → 已审核）
//   ② 收货：按明细行逐条收货，允许**分批**（一次下单、多次到货）
//          全部收齐后订单转「已完成」
//
// 应付账款口径：**按「实收数量」计价**，不按订单数量。
// 这是会计上的收入费用配比原则 —— 没收到的货不构成负债。
// 若按订单数量记应付，会出现「货没到、账上先欠钱」的假象。

引入 "主数据"
引入 { 单据状态 } 从 "主数据"
引入 "库存服务"
引入 "数学"

// ------------------------------------------------------------ 类型定义

类型 采购明细 = {
    物料编号: 文本,
    数量: 整数,
    单价: 整数,        // 分
    实收数量: 整数
}

类型 采购订单 = {
    单号: 文本,
    供应商编号: 文本,
    订货日期: 文本,
    明细: 列表,
    状态: 单据状态
}

// ------------------------------------------------------------ 构造辅助

请 造采购明细(物料编号, 数量, 单价)
    返回 采购明细(物料编号 是 物料编号, 数量 是 数量,
    单价 是 单价, 实收数量 是 0)
结束

请 造采购订单(单号, 供应商编号, 订货日期, 明细)
    返回 采购订单(单号 是 单号, 供应商编号 是 供应商编号,
    订货日期 是 订货日期, 明细 是 明细, 状态 是 单据状态.草稿)
结束

// ------------------------------------------------------------ 金额计算

请 明细金额(某明细)
    返回 某明细.数量 * 某明细.单价
结束

请 订单金额(某订单)
    定义 合计 = 0
    遍历 某订单.明细 中的每个 某明细
        合计 = 合计 + 明细金额(某明细)
    结束
    返回 合计
结束

// 某明细的未收数量
请 明细未收(某明细)
    返回 某明细.数量 - 某明细.实收数量
结束

// 订单的未收数量合计
请 订单未收合计(某订单)
    定义 合计 = 0
    遍历 某订单.明细 中的每个 某明细
        合计 = 合计 + 明细未收(某明细)
    结束
    返回 合计
结束

// 订单**实收部分**的金额（应付账款口径）
请 已收金额(某订单, 单价表)
    定义 合计 = 0
    遍历 某订单.明细 中的每个 某明细
        合计 = 合计 + 某明细.实收数量 * 某明细.单价
    结束
    返回 合计
结束

// 是否已全部收齐
请 已收齐(某订单)
    遍历 某订单.明细 中的每个 某明细
        如果 明细未收(某明细) > 0 则
            返回 假
        结束
    结束
    返回 真
结束

// ------------------------------------------------------------ 审核

// 审核订单：草稿 → 已审核。返回 [新订单, 说明]
请 审核采购单(某订单)
    如果 某订单.状态 不是 单据状态.草稿 则
        返回 [某订单, "只有草稿状态的订单可以审核"]
    结束
    如果 长度(某订单.明细) 是 0 则
        返回 [某订单, "订单没有任何明细，不能审核"]
    结束
    定义 新订单 = 采购订单(单号 是 某订单.单号,
    供应商编号 是 某订单.供应商编号,
    订货日期 是 某订单.订货日期,
    明细 是 某订单.明细,
    状态 是 单据状态.已审核)
    返回 [新订单, "审核通过"]
结束

// ------------------------------------------------------------ 收货
//
// 对某一行明细收货。返回 [新订单, 入库数量, 入库单价, 说明]
// 入库数量为 0 表示收货失败（说明给出原因）。
//
// **本函数不做记账**：它只负责「订单侧」的数量推进与校验。
// 库存台账的更新、复式凭证的生成由上层 `企业.sy` 编排 ——
// 一张收货单要同时改订单、库存、应付三处，这就是「事务」的由来。

请 收采购明细(某订单, 物料编号, 数量)
    // 可收货的状态：已审核（首次收）与已执行（续收）。
    // 草稿不可收（未审核）；已完成不可收（已收齐，再收必超量）。
    // 报错文案带上**实际状态**：只写「不能收货」会让用户以为是没审核，
    // 而真因可能是「已收完」——状态机类错误，报错点与真因点极容易不一致。
    如果 某订单.状态 是 单据状态.草稿 则
        返回 [某订单, 0, 0, "订单尚未审核，不能收货"]
    结束
    如果 某订单.状态 是 单据状态.已完成 则
        返回 [某订单, 0, 0, "订单已收齐，不能继续收货"]
    结束
    如果 某订单.状态 是 单据状态.已作废 则
        返回 [某订单, 0, 0, "订单已作废，不能收货"]
    结束
    如果 数量 <= 0 则
        返回 [某订单, 0, 0, "收货数量必须大于 0"]
    结束
    定义 新明细 = []
    定义 命中 = 假
    定义 出错说明 = ""
    遍历 某订单.明细 中的每个 某明细
        如果 某明细.物料编号 是 物料编号 则
            定义 未收 = 明细未收(某明细)
            如果 数量 > 未收 则
                出错说明 = "收货数量超过未收数量：未收 " + 转文本(未收) +
                    "，本次 " + 转文本(数量)
                入列(新明细, 某明细)
            否则
                命中 = 真
                入列(新明细, 采购明细(物料编号 是 物料编号,
                数量 是 某明细.数量, 单价 是 某明细.单价,
                实收数量 是 某明细.实收数量 + 数量))
            结束
        否则
            入列(新明细, 某明细)
        结束
    结束
    如果 出错说明 不是 "" 则
        返回 [某订单, 0, 0, 出错说明]
    结束
    如果 非 命中 则
        返回 [某订单, 0, 0, "订单里没有物料「" + 物料编号 + "」"]
    结束
    定义 新订单 = 采购订单(单号 是 某订单.单号,
    供应商编号 是 某订单.供应商编号,
    订货日期 是 某订单.订货日期,
    明细 是 新明细,
    状态 是 单据状态.已执行)
    // 收齐则推进到「已完成」；未收齐停在「已执行」，后续仍可续收。
    // 若不加区分地一律置「已审核」，就分不出「一单没动的已审核」与
    // 「已收一部分的已审核」—— 状态机少一态，下游判断就没法准确。
    如果 已收齐(新订单) 则
        新订单.状态 = 单据状态.已完成
    结束
    定义 单价 = 取明细单价(新订单, 物料编号)
    返回 [新订单, 数量, 单价, "收货成功"]
结束

// 取某明细行的单价（供上层记账用）
请 取明细单价(某订单, 物料编号)
    遍历 某订单.明细 中的每个 某明细
        如果 某明细.物料编号 是 物料编号 则
            返回 某明细.单价
        结束
    结束
    返回 0
结束

// ------------------------------------------------------------ 应付汇总

// 按供应商汇总应付账款（只算已收部分）。返回 [供应商编号, 金额]
请 应付清单(全部订单)
    定义 桶 = {}
    定义 顺序 = []
    遍历 全部订单 中的每个 某订单
        如果 某订单.状态 是 单据状态.已作废 则
            继续
        结束
        定义 码 = 某订单.供应商编号
        如果 非 有键(桶, 码) 则
            桶[码] = 0
            入列(顺序, 码)
        结束
        桶[码] = 桶[码] + 已收金额(某订单, 空)
    结束
    定义 行 = []
    遍历 顺序 中的每个 码
        入列(行, [码, 桶[码]])
    结束
    返回 行
结束