// ============================================================ 财务服务
//
// 职责：**复式记账**（Double-Entry Bookkeeping）。
//
// 这是 ERP 区别于「进销存」的分水岭：进销存只记数量与金额，ERP 还要
// 让每一笔业务都变成会计凭证，且**有借必有贷、借贷必相等**。
//
// 三条会计铁律（本模块的校验全部围绕它们）：
//   ① 每张凭证的借方合计 **必须等于** 贷方合计 —— 否则凭证非法；
//   ② 科目余额方向固定（资产/成本在借方，负债/权益/损益在贷方），
//      余额落在反方向时应显示为负（红字），不能悄悄取绝对值；
//   ③ 凭证一经记账**不可修改**，只能「红冲」（记一张反向凭证）。
//
// 为什么第 ③ 条重要：可修改的账 = 可篡改的账。审计要求账务留痕，
// 故本模块**不提供**修改凭证的函数，只提供生成与红冲。

引入 "主数据"
引入 { 借贷方向 } 从 "主数据"
引入 "数学"

// ------------------------------------------------------------ 类型定义

// 凭证分录（一条借贷记录）
类型 分录 = {
    科目编码: 文本,
    方向: 借贷方向,
    金额: 整数        // 分，恒为正
}

// 记账凭证
类型 凭证 = {
    凭证号: 文本,
    日期: 文本,
    摘要: 文本,
    分录: 列表
}

// 科目余额
类型 科目余额 = {
    科目编码: 文本,
    借方合计: 整数,
    贷方合计: 整数
}

// ------------------------------------------------------------ 构造辅助

请 造分录(科目编码, 方向, 金额)
    返回 分录(科目编码 是 科目编码, 方向 是 方向, 金额 是 金额)
结束

请 造凭证(凭证号, 日期, 摘要, 分录列表)
    返回 凭证(凭证号 是 凭证号, 日期 是 日期,
    摘要 是 摘要, 分录 是 分录列表)
结束

// ------------------------------------------------------------ 借贷校验

请 借方合计(某凭证)
    定义 合计 = 0
    遍历 某凭证.分录 中的每个 某分录
        如果 某分录.方向 是 借贷方向.借 则
            合计 = 合计 + 某分录.金额
        结束
    结束
    返回 合计
结束

请 贷方合计(某凭证)
    定义 合计 = 0
    遍历 某凭证.分录 中的每个 某分录
        如果 某分录.方向 是 借贷方向.贷 则
            合计 = 合计 + 某分录.金额
        结束
    结束
    返回 合计
结束

// 校验凭证是否合法。返回 [是否合法, 说明]
//
// **借贷必相等**是会计恒等式，凭证不平意味着账必然错。
// 这里把它做成记账前的**硬闸门**：不平的凭证拒绝入账，而不是记下去
// 让错误在报表里显形 —— 那时已经很难追溯到是哪一笔了。
请 校验凭证(某凭证)
    如果 长度(某凭证.分录) < 2 则
        返回 [假, "凭证至少要有两条分录（一借一贷）"]
    结束
    定义 借 = 借方合计(某凭证)
    定义 贷 = 贷方合计(某凭证)
    如果 借 是 0 且 贷 是 0 则
        返回 [假, "凭证金额为零，没有记账意义"]
    结束
    如果 借 不是 贷 则
        返回 [假, "借贷不平：借方 " + 转文本(借) +
            " 分，贷方 " + 转文本(贷) +
            " 分，差额 " + 转文本(借 - 贷) + " 分"]
    结束
    返回 [真, "借贷平衡"]
结束

// ------------------------------------------------------------ 记账
//
// 把凭证追加到账簿。返回 [新账簿, 是否成功, 说明]
// **不修改入参账簿**（服务层无状态约定）。

请 记账(账簿, 某凭证)
    定义 检查 = 校验凭证(某凭证)
    如果 非 检查[0] 则
        返回 [账簿, 假, "凭证非法：" + 检查[1]]
    结束
    定义 新账簿 = []
    遍历 账簿 中的每个 已有
        入列(新账簿, 已有)
    结束
    入列(新账簿, 某凭证)
    返回 [新账簿, 真, "记账成功"]
结束

// 红冲：生成一张借贷方向相反、金额相同的凭证（负数金额不用，
// 会计上红冲是「反向分录」而非「负金额」，这样借贷合计仍为正）。
请 红冲凭证(原凭证, 新凭证号, 日期)
    定义 反向 = []
    遍历 原凭证.分录 中的每个 某分录
        如果 某分录.方向 是 借贷方向.借 则
            入列(反向, 造分录(某分录.科目编码, 借贷方向.贷, 某分录.金额))
        否则
            入列(反向, 造分录(某分录.科目编码, 借贷方向.借, 某分录.金额))
        结束
    结束
    返回 造凭证(新凭证号, 日期, "红冲 " + 原凭证.凭证号, 反向)
结束

// ------------------------------------------------------------ 余额与试算

// 某科目的借贷发生额。返回 [借方, 贷方]
请 科目发生额(账簿, 科目编码)
    定义 借 = 0
    定义 贷 = 0
    遍历 账簿 中的每个 某凭证
        遍历 某凭证.分录 中的每个 某分录
            如果 某分录.科目编码 是 科目编码 则
                如果 某分录.方向 是 借贷方向.借 则
                    借 = 借 + 某分录.金额
                否则
                    贷 = 贷 + 某分录.金额
                结束
            结束
        结束
    结束
    返回 [借, 贷]
结束

// 科目余额（按余额方向给出）。返回 [余额方向, 余额金额]
//
// **负数要如实显示**：若资产科目贷方大于借方，余额为负（红字），
// 这本身就是异常信号。取绝对值会把异常藏起来。
请 科目余额(账簿, 全部科目, 科目编码)
    定义 科目记录 = 主数据.找科目(全部科目, 科目编码)
    如果 科目记录 是 空 则
        返回 [借贷方向.借, 0]
    结束
    定义 发生 = 科目发生额(账簿, 科目编码)
    定义 余额 = 发生[0] - 发生[1]
    如果 科目记录.余额方向 是 借贷方向.贷 则
        返回 [借贷方向.贷, 发生[1] - 发生[0]]
    结束
    返回 [借贷方向.借, 余额]
结束

// 试算平衡：全部科目的借方余额合计 == 贷方余额合计。
// 这是复式记账的**自检**：只要每张凭证都平，试算必然平衡；
// 若不平衡，说明账簿被外部篡改过。返回 [是否平衡, 借方合计, 贷方合计]
请 试算平衡(账簿, 全部科目)
    定义 借合计 = 0
    定义 贷合计 = 0
    遍历 全部科目 中的每个 科目记录
        定义 发生 = 科目发生额(账簿, 科目记录.编码)
        如果 科目记录.余额方向 是 借贷方向.借 则
            借合计 = 借合计 + 发生[0] - 发生[1]
        否则
            贷合计 = 贷合计 + 发生[1] - 发生[0]
        结束
    结束
    // 注：这里按「余额方向」归集，与损益类科目未结转时可能出现
    // 借贷双方各自包含负数的情况 —— 关键在于**两者仍应相等**。
    返回 [借合计 是 贷合计, 借合计, 贷合计]
结束

// 全账簿借方发生额合计（用于独立核对）
请 全账借方(账簿)
    定义 合计 = 0
    遍历 账簿 中的每个 某凭证
        合计 = 合计 + 借方合计(某凭证)
    结束
    返回 合计
结束

请 全账贷方(账簿)
    定义 合计 = 0
    遍历 账簿 中的每个 某凭证
        合计 = 合计 + 贷方合计(某凭证)
    结束
    返回 合计
结束

// ------------------------------------------------------------ 利润表数据

// 损益类科目净发生额（贷方 − 借方），收入为正、费用为负。
请 损益净额(账簿, 全部科目, 类别)
    定义 合计 = 0
    遍历 全部科目 中的每个 科目记录
        如果 科目记录.类别 是 类别 则
            定义 发生 = 科目发生额(账簿, 科目记录.编码)
            合计 = 合计 + 发生[1] - 发生[0]
        结束
    结束
    返回 合计
结束