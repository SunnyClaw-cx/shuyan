// ============================================================ 销售服务
//
// 职责：销售订单的**纯计算**、发货校验与收入确认。
//
// 与采购服务**结构对称**（订单 → 审核 → 发货），但有三处关键差异：
//   ① 发货要查**信用额度**（超额不放货）—— 采购是付钱，销售是收钱；
//   ② 发货时要结转**销售成本**（用库存的移动加权平均成本）；
//   ③ 要算**毛利** = 销售收入 − 销售成本，这是经营分析的核心指标。
//
// 收入确认口径：**按发货数量确认**，不按订单数量（与采购同口径，
// 都是「实际发生」原则）。

引入 "主数据"
引入 { 单据状态 } 从 "主数据"
引入 "数学"

// ------------------------------------------------------------ 类型定义

类型 销售明细 = {
    物料编号: 文本,
    数量: 整数,
    售价: 整数,        // 分
    已发数量: 整数,
    成本金额: 整数     // 分，发货时由库存**实际结转额**回填（累加）
}

类型 销售订单 = {
    单号: 文本,
    客户编号: 文本,
    订单日期: 文本,
    明细: 列表,
    状态: 单据状态
}

// ------------------------------------------------------------ 构造辅助

请 造销售明细(物料编号, 数量, 售价)
    返回 销售明细(物料编号 是 物料编号, 数量 是 数量,
    售价 是 售价, 已发数量 是 0, 成本金额 是 0)
结束

请 造销售订单(单号, 客户编号, 订单日期, 明细)
    返回 销售订单(单号 是 单号, 客户编号 是 客户编号,
    订单日期 是 订单日期, 明细 是 明细, 状态 是 单据状态.草稿)
结束

// ------------------------------------------------------------ 金额计算

请 明细金额(某明细)
    返回 某明细.数量 * 某明细.售价
结束

请 订单金额(某订单)
    定义 合计 = 0
    遍历 某订单.明细 中的每个 某明细
        合计 = 合计 + 明细金额(某明细)
    结束
    返回 合计
结束

请 明细未发(某明细)
    返回 某明细.数量 - 某明细.已发数量
结束

请 订单未发合计(某订单)
    定义 合计 = 0
    遍历 某订单.明细 中的每个 某明细
        合计 = 合计 + 明细未发(某明细)
    结束
    返回 合计
结束

// 订单的**已发货部分**收入（收入确认口径）
请 已发金额(某订单)
    定义 合计 = 0
    遍历 某订单.明细 中的每个 某明细
        合计 = 合计 + 某明细.已发数量 * 某明细.售价
    结束
    返回 合计
结束

// 订单的**已发货部分**成本（成本结转口径）
//
// 直接累加库存回填的**实际结转额**，而不是「已发数量 × 某个单位成本」——
// 后者会与库存实际扣减的金额产生取整尾差（见 `库存服务.出库` 的
// 「先乘后除再取整」说明），使**利润表与总账对不上**，
// 且尾差会随发货批次累积。以实际结转额入账是唯一保证「账账相符」的口径。
请 已发成本(某订单)
    定义 合计 = 0
    遍历 某订单.明细 中的每个 某明细
        合计 = 合计 + 某明细.成本金额
    结束
    返回 合计
结束

// 毛利额（分）
请 毛利额(某订单)
    返回 已发金额(某订单) - 已发成本(某订单)
结束

请 已发齐(某订单)
    遍历 某订单.明细 中的每个 某明细
        如果 明细未发(某明细) > 0 则
            返回 假
        结束
    结束
    返回 真
结束

// ------------------------------------------------------------ 审核

请 审核销售单(某订单)
    如果 某订单.状态 不是 单据状态.草稿 则
        返回 [某订单, "只有草稿状态的订单可以审核"]
    结束
    如果 长度(某订单.明细) 是 0 则
        返回 [某订单, "订单没有任何明细，不能审核"]
    结束
    定义 新订单 = 销售订单(单号 是 某订单.单号,
    客户编号 是 某订单.客户编号,
    订单日期 是 某订单.订单日期,
    明细 是 某订单.明细,
    状态 是 单据状态.已审核)
    返回 [新订单, "审核通过"]
结束

// ------------------------------------------------------------ 信用检查
//
// 检查「已有应收 + 本单未发金额」是否超过信用额度。
// 返回 [是否允许, 说明]
//
// 注意口径：已发货但未收款的部分才算应收占用（未发货的订单不占额度）。

请 检查信用(单位记录, 全部订单, 本次金额)
    如果 单位记录.信用额度 <= 0 则
        返回 [假, "客户「" + 单位记录.名称 + "」未设置信用额度"]
    结束
    定义 已占用 = 应收占用(全部订单, 单位记录.编号)
    定义 合计 = 已占用 + 本次金额
    如果 合计 > 单位记录.信用额度 则
        返回 [假, "超信用额度：已占用 " + 主数据.分转元(已占用) +
            " + 本次 " + 主数据.分转元(本次金额) +
            " > 额度 " + 主数据.分转元(单位记录.信用额度)]
    结束
    返回 [真, "信用充足"]
结束

// 某客户当前应收占用（已发货但未结清的金额）。简化口径：
// 全部已发货订单的已发金额之和（真实系统还要减去已收款）。
请 应收占用(全部订单, 客户编号)
    定义 合计 = 0
    遍历 全部订单 中的每个 某订单
        如果 某订单.状态 是 单据状态.已作废 则
            继续
        结束
        如果 某订单.客户编号 是 客户编号 则
            合计 = 合计 + 已发金额(某订单)
        结束
    结束
    返回 合计
结束

// ------------------------------------------------------------ 发货
//
// 对某一行明细发货。返回：
//   [新订单, 发货数量, 成本金额, 说明]
// 数量为 0 表示发货失败。
//
// `成本金额` 由调用方从库存台账**实际结转额**传入（服务层不持有状态）。
// 这样「取成本」与「改订单」是两步，中间可以被上层的事务编排拦住；
// 也保证订单记的成本与库存扣掉的金额**是同一个数**，不会各算各的。
请 发销售明细(某订单, 物料编号, 数量, 成本金额)
    // 与 `采购服务.收采购明细` 同口径：可发货的状态是「已审核」与「已执行」。
    // 文案区分三种不可发货状态，避免把「已发齐」误报成「未审核」。
    如果 某订单.状态 是 单据状态.草稿 则
        返回 [某订单, 0, 0, "订单尚未审核，不能发货"]
    结束
    如果 某订单.状态 是 单据状态.已完成 则
        返回 [某订单, 0, 0, "订单已发齐，不能继续发货"]
    结束
    如果 某订单.状态 是 单据状态.已作废 则
        返回 [某订单, 0, 0, "订单已作废，不能发货"]
    结束
    如果 数量 <= 0 则
        返回 [某订单, 0, 0, "发货数量必须大于 0"]
    结束
    定义 新明细 = []
    定义 命中 = 假
    定义 出错说明 = ""
    遍历 某订单.明细 中的每个 某明细
        如果 某明细.物料编号 是 物料编号 则
            定义 未发 = 明细未发(某明细)
            如果 数量 > 未发 则
                出错说明 = "发货数量超过未发数量：未发 " + 转文本(未发) +
                    "，本次 " + 转文本(数量)
                入列(新明细, 某明细)
            否则
                命中 = 真
                入列(新明细, 销售明细(物料编号 是 物料编号,
                数量 是 某明细.数量, 售价 是 某明细.售价,
                已发数量 是 某明细.已发数量 + 数量,
                成本金额 是 某明细.成本金额 + 成本金额))
            结束
        否则
            入列(新明细, 某明细)
        结束
    结束
    如果 出错说明 不是 "" 则
        返回 [某订单, 0, 0, 出错说明]
    结束
    如果 非 命中 则
        返回 [某订单, 0, 0, "订单里没有物料「" + 物料编号 + "」"]
    结束
    定义 新订单 = 销售订单(单号 是 某订单.单号,
    客户编号 是 某订单.客户编号,
    订单日期 是 某订单.订单日期,
    明细 是 新明细,
    状态 是 单据状态.已执行)
    如果 已发齐(新订单) 则
        新订单.状态 = 单据状态.已完成
    结束
    返回 [新订单, 数量, 成本金额, "发货成功"]
结束

// ------------------------------------------------------------ 明细查询

// 取某明细行的售价（供上层算收入金额与信用占用）
//
// 与 `采购服务.取明细单价` **对称**：这里刻意不写进「金额计算」段，
// 而是独立成段 —— 「按物料编号回查某一行的单价/售价」是**查询**语义，
// 不是计算语义。混在一起会让人以为它参与订单金额的推导，其实不参与。

请 取明细售价(某订单, 物料编号)
    遍历 某订单.明细 中的每个 某明细
        如果 某明细.物料编号 是 物料编号 则
            返回 某明细.售价
        结束
    结束
    返回 0
结束

// ------------------------------------------------------------ 毛利汇总

// 按物料汇总毛利。返回 [物料编号, 销售收入, 销售成本, 毛利]
请 毛利清单(全部订单)
    定义 收入桶 = {}
    定义 成本桶 = {}
    定义 顺序 = []
    遍历 全部订单 中的每个 某订单
        如果 某订单.状态 是 单据状态.已作废 则
            继续
        结束
        遍历 某订单.明细 中的每个 某明细
            定义 码 = 某明细.物料编号
            如果 非 有键(收入桶, 码) 则
                收入桶[码] = 0
                成本桶[码] = 0
                入列(顺序, 码)
            结束
            收入桶[码] = 收入桶[码] + 某明细.已发数量 * 某明细.售价
            成本桶[码] = 成本桶[码] + 某明细.成本金额
        结束
    结束
    定义 行 = []
    遍历 顺序 中的每个 码
        入列(行, [码, 收入桶[码], 成本桶[码],
        收入桶[码] - 成本桶[码]])
    结束
    返回 行
结束

// 说明：金额显示（分转元 / 千分位）已上移至 `主数据.sy` ——
// 它是**与业务无关**的纯展示工具，不应挂在销售服务上，
// 否则任何要打印金额的模块都得连销售概念一起引入。