// ============================================================ 企业（状态持有 + 事务编排）
//
// 这是整个 ERP 的**中枢**。前面五个模块（主数据 / 库存服务 / 采购服务 /
// 销售服务 / 财务服务）全是**无状态纯函数**，只负责「算」；真正的状态
// —— 物料、单位、科目、库存台账、订单、账簿 —— 全部集中在本模块。
//
// ---------------------------------------------------------------- 为什么要分层
//
// 直觉上，「收货」就是「库存 +N」这件事，一个函数写完最省事。但真实的
// 收货要**同时**改三处：
//     ① 订单：某行明细的 实收数量 +N
//     ② 库存：台账 数量 +N、金额 +N×单价
//     ③ 账簿：记一张凭证（借「库存商品」贷「应付账款」）
//
// 三处必须**同生共死**。枢言（以及绝大多数简化实现）**没有事务回滚**：
// 若第 ③ 步失败，前两步已经改掉的状态不会自动退回来，账就烂了。
//
// 应对办法是**两阶段提交**（Two-Phase Commit 的简化版）：
//     阶段一「预演」：把三处要做的改动**先算出来**（只调用纯函数），
//                     任何一处不合法就立刻返回失败，此时**一个字节都没改**；
//     阶段二「提交」：预演全部通过后，才真正把结果写回状态变量。
//
// 「预演**绝不改状态**」是这套设计的命根子。因此本模块把「编号分配」
// （递增序号，是状态变更）**全部推迟到提交阶段**：预演时构造的凭证用
// 空号占位、只拿去做借贷校验；只有确定要入账了，才去取真号。
// 若在预演阶段就发号，一次失败的收货就会白白吃掉一个凭证号 ——
// 那既污染了账，也让「预演无副作用」的说法站不住。
//
// 提交阶段只做赋值与入账，不会再失败。这就是「先把所有可能出错的事
// 做完，再做不可能出错的事」—— 比事后回滚简单得多，也更可靠。
//
// ---------------------------------------------------------------- 引用语义提醒
//
// 枢言的 `定义 乙 = 甲` 是**引用**，不是拷贝；列表切片、映射合并也**只是浅拷贝**。
// 故本模块对状态的更新一律采取**整体替换**（如 `库存台账 = 新台账`），
// 而不是在原对象上就地改字段 —— 就地改会让所有持有旧引用的地方同步变化，
// 排查时极难定位。整体替换则是「新对象进、旧对象出」，语义干净。

引入 "主数据"
引入 { 借贷方向 } 从 "主数据"
引入 "库存服务"
引入 "采购服务"
引入 "销售服务"
引入 "财务服务"

// ------------------------------------------------------------ 企业状态（集中持有）

// 主数据
定义 物料表 = []
定义 单位表 = []
定义 科目表 = []

// 库存
定义 库存台账 = []
定义 库存流水 = []

// 单据
定义 采购订单表 = []
定义 销售订单表 = []

// 财务
定义 账簿 = []

// 单据序号（各单据类型独立编号）
定义 采购序号 = 0
定义 销售序号 = 0
定义 凭证序号 = 0
定义 流水序号 = 0

// 最近一次失败原因（供调用方在失败后读取，便于定位）
定义 最近错误 = ""

// ------------------------------------------------------------ 主数据登记

请 登记物料(某物料)
    入列(物料表, 某物料)
    返回 某物料.编号
结束

请 登记单位(某单位)
    入列(单位表, 某单位)
    返回 某单位.编号
结束

请 登记科目(某科目)
    入列(科目表, 某科目)
    返回 某科目.编码
结束

// 编号生成：返回不重复的新单据号。
// 序号是**状态**（递增、不可重复），单号格式是**纯计算**（`主数据.编单号`）——
// 两者分开：状态归本模块，格式归最底层，格式改一次全工程一致。
请 下一个采购号()
    采购序号 = 采购序号 + 1
    返回 主数据.编单号("CG", 采购序号)
结束

请 下一个销售号()
    销售序号 = 销售序号 + 1
    返回 主数据.编单号("XS", 销售序号)
结束

请 下一个凭证号()
    凭证序号 = 凭证序号 + 1
    返回 主数据.编单号("记", 凭证序号)
结束

请 下一个流水号()
    流水序号 = 流水序号 + 1
    返回 主数据.编单号("LS", 流水序号)
结束

// ------------------------------------------------------------ 记账（内部唯一入口）
//
// **所有**入账动作都走这里，不允许别处直接 `入列(账簿, ...)`。
// 理由：`入账` 内含「借贷必须平衡」的硬闸门，绕过它就能把不平的凭证
// 塞进账簿，试算平衡会在事后才报警 —— 那时已经查不出是哪一笔了。
// 「同一语义只有一个入口」是本工程的铁律之一。

请 入账(某凭证)
    定义 结果 = 财务服务.记账(账簿, 某凭证)
    如果 非 结果[1] 则
        最近错误 = 结果[2]
        返回 假
    结束
    账簿 = 结果[0]
    返回 真
结束

// ------------------------------------------------------------ 流水登记（内部唯一入口）
//
// 与 `入账` 同理：流水只能从这里进，保证「登记流水」这个动作只有一份实现，
// 不会出现某处忘了补 `关联单据`、某处把「入/出」写反的情况。

请 记流水(方向, 物料编号, 数量, 单价, 金额, 关联单据, 日期)
    入列(库存流水, 库存服务.造流水(下一个流水号(), 物料编号, 方向,
    数量, 单价, 金额, 关联单据, 日期))
结束

// ------------------------------------------------------------ 库存业务：采购收货
//
// 两阶段提交。返回 [是否成功, 说明]。
// 成功时：订单实收数量已推进、库存已加、应付凭证已入账，三者口径一致。

请 采购收货(单号, 物料编号, 数量, 日期)
    最近错误 = ""
    // ============ 阶段一：预演（只读 + 纯计算，绝不改状态） ============
    定义 原订单 = 找采购单(单号)
    如果 原订单 是 空 则
        最近错误 = "找不到采购单「" + 单号 + "」"
        返回 [假, 最近错误]
    结束
    // ① 订单侧：算出推进后的新订单
    定义 收货结果 = 采购服务.收采购明细(原订单, 物料编号, 数量)
    定义 新订单 = 收货结果[0]
    定义 实收数量 = 收货结果[1]
    如果 实收数量 是 0 则
        最近错误 = 收货结果[3]
        返回 [假, 最近错误]
    结束
    定义 入库单价 = 收货结果[2]
    定义 入库金额 = 实收数量 * 入库单价
    // ② 库存侧：算出加计后的新台账
    定义 库存结果 = 库存服务.入库(库存台账, 物料编号, 实收数量, 入库单价)
    定义 新台账 = 库存结果[0]
    // ③ 财务侧：构造凭证要素并校验（用空号占位，**不发真号**）
    定义 要素 = 采购要素(单号, 物料编号, 入库金额)
    定义 检查 = 财务服务.校验凭证(财务服务.造凭证("", 日期, 要素[0], 要素[1]))
    如果 非 检查[0] 则
        最近错误 = "采购凭证不合法：" + 检查[1]
        返回 [假, 最近错误]
    结束
    // ============ 阶段二：提交（只做赋值、登记、入账） ============
    替换采购单(单号, 新订单)
    库存台账 = 新台账
    记流水("入", 物料编号, 实收数量, 入库单价, 入库金额, 单号, 日期)
    入账(财务服务.造凭证(下一个凭证号(), 日期, 要素[0], 要素[1]))
    返回 [真, "收货 " + 转文本(实收数量) + "，入库金额 "
        + 主数据.分转元(入库金额) + "，凭证 " + 主数据.编单号("记", 凭证序号)]
结束

// ------------------------------------------------------------ 库存业务：销售发货
//
// 与采购收货**同构**，但多了两件事：成本结转（从库存取实际结转额）、
// 信用校验。返回 [是否成功, 说明]。

请 销售发货(单号, 物料编号, 数量, 日期)
    最近错误 = ""
    // ============ 阶段一：预演 ============
    定义 原订单 = 找销售单(单号)
    如果 原订单 是 空 则
        最近错误 = "找不到销售单「" + 单号 + "」"
        返回 [假, 最近错误]
    结束
    // ① 库存侧**先算**：能不能扣、扣多少成本。
    //    先算库存的原因：卖不出去的货**根本不该谈信用**，
    //    否则会把「库存不足」误报成「信用不足」，把用户引到错误方向。
    定义 出库结果 = 库存服务.出库(库存台账, 物料编号, 数量)
    定义 新台账 = 出库结果[0]
    定义 成本金额 = 出库结果[1]
    如果 成本金额 是 0 则
        最近错误 = 出库结果[2]
        返回 [假, 最近错误]
    结束
    // ② 信用校验：本次发货收入 + 已占用 是否超额度
    定义 客户 = 主数据.找单位(单位表, 原订单.客户编号)
    如果 客户 是 空 则
        最近错误 = "找不到客户「" + 原订单.客户编号 + "」"
        返回 [假, 最近错误]
    结束
    定义 售价 = 销售服务.取明细售价(原订单, 物料编号)
    定义 本次收入 = 数量 * 售价
    定义 信用结果 = 销售服务.检查信用(客户, 销售订单表, 本次收入)
    如果 非 信用结果[0] 则
        最近错误 = 信用结果[1]
        返回 [假, 最近错误]
    结束
    // ③ 订单侧：推进已发数量并回填成本金额
    定义 发货结果 = 销售服务.发销售明细(原订单, 物料编号, 数量, 成本金额)
    定义 新订单 = 发货结果[0]
    如果 发货结果[1] 是 0 则
        最近错误 = 发货结果[3]
        返回 [假, 最近错误]
    结束
    // ④ 财务侧：收入与成本**两张**凭证，都要先校验（用空号占位）
    定义 收入要素 = 销售要素(单号, 物料编号, 本次收入)
    定义 成本要素 = 结转要素(单号, 物料编号, 成本金额)
    定义 检查收 = 财务服务.校验凭证(
        财务服务.造凭证("", 日期, 收入要素[0], 收入要素[1]))
    如果 非 检查收[0] 则
        最近错误 = "收入凭证不合法：" + 检查收[1]
        返回 [假, 最近错误]
    结束
    定义 检查本 = 财务服务.校验凭证(
        财务服务.造凭证("", 日期, 成本要素[0], 成本要素[1]))
    如果 非 检查本[0] 则
        最近错误 = "成本凭证不合法：" + 检查本[1]
        返回 [假, 最近错误]
    结束
    // ============ 阶段二：提交 ============
    替换销售单(单号, 新订单)
    库存台账 = 新台账
    记流水("出", 物料编号, 数量, 单位价(成本金额, 数量), 成本金额, 单号, 日期)
    入账(财务服务.造凭证(下一个凭证号(), 日期, 收入要素[0], 收入要素[1]))
    入账(财务服务.造凭证(下一个凭证号(), 日期, 成本要素[0], 成本要素[1]))
    定义 毛利 = 本次收入 - 成本金额
    返回 [真, "发货 " + 转文本(数量)
        + "，收入 " + 主数据.分转元(本次收入)
        + "，成本 " + 主数据.分转元(成本金额)
        + "，毛利 " + 主数据.分转元(毛利)]
结束

// 单价 = 金额 ÷ 数量（仅供流水展示；金额才是权威值，见 `库存服务` 说明）
请 单位价(金额, 数量)
    如果 数量 <= 0 则
        返回 0
    结束
    返回 数学.向下取整(金额 / 数量)
结束

// ------------------------------------------------------------ 凭证要素构造
//
// 为什么返回「要素」而不是完整凭证：凭证号是**状态**（要发号），
// 必须有且只有一次分配时机。把「摘要 + 分录」与「凭证号」拆开，
// 预演阶段拿要素去校验（无副作用），提交阶段才发号装配。
//
// 会计科目编码约定（与 `科目表` 中的定义对应）：
//   1001 库存商品        资产
//   1002 应收账款        资产
//   2001 应付账款        负债
//   3001 实收资本        所有者权益
//   5001 主营业务收入    损益
//   5401 主营业务成本    成本
//   5901 待处理财产损溢  损益
//
// 采购入库：借 库存商品 / 贷 应付账款
// 销售确认：借 应收账款 / 贷 主营业务收入
// 结转成本：借 主营业务成本 / 贷 库存商品
// 盘盈：    借 库存商品 / 贷 待处理财产损溢
// 盘亏：    借 待处理财产损溢 / 贷 库存商品
//
// 每张凭证都写成**显式的两条分录**，而不是一条金额为负的分录 ——
// 会计上负金额分录会让「借方合计」「贷方合计」失去意义，
// 也使试算平衡的判据失效。宁可多写一行，也不破坏恒等式。

请 采购要素(单号, 物料编号, 金额)
    定义 摘要 = "采购入库 " + 单号 + " / " + 物料编号
    返回 [摘要, [
    财务服务.造分录("1001", 借贷方向.借, 金额),
    财务服务.造分录("2001", 借贷方向.贷, 金额)
    ]]
结束

请 销售要素(单号, 物料编号, 金额)
    定义 摘要 = "销售确认 " + 单号 + " / " + 物料编号
    返回 [摘要, [
    财务服务.造分录("1002", 借贷方向.借, 金额),
    财务服务.造分录("5001", 借贷方向.贷, 金额)
    ]]
结束

请 结转要素(单号, 物料编号, 金额)
    定义 摘要 = "结转成本 " + 单号 + " / " + 物料编号
    返回 [摘要, [
    财务服务.造分录("5401", 借贷方向.借, 金额),
    财务服务.造分录("1001", 借贷方向.贷, 金额)
    ]]
结束

// ------------------------------------------------------------ 盘点
//
// 盘盈盘亏走「待处理财产损溢」科目，不直接冲减成本 ——
// 这是会计准则要求：盘盈亏要先挂账，查明原因后再转销。
// 若直接计入损益，等于把「管理漏洞」伪装成「经营成果」。

请 盘点(物料编号, 实际数量, 日期)
    最近错误 = ""
    定义 结果 = 库存服务.盘点调整(库存台账, 物料编号, 实际数量)
    定义 新台账 = 结果[0]
    定义 差异数量 = 结果[1]
    定义 差异金额 = 结果[2]
    如果 差异数量 是 0 则
        返回 [真, "账实相符，无需调整"]
    结束
    定义 要素 = 盘点要素(物料编号, 差异金额)
    定义 检查 = 财务服务.校验凭证(财务服务.造凭证("", 日期, 要素[0], 要素[1]))
    如果 非 检查[0] 则
        最近错误 = "盘点凭证不合法：" + 检查[1]
        返回 [假, 最近错误]
    结束
    库存台账 = 新台账
    定义 方向 = "入"
    如果 差异金额 < 0 则
        方向 = "出"
    结束
    记流水(方向, 物料编号, 差异数量, 单位价(差异金额, 差异数量),
        差异金额, "盘点", 日期)
    入账(财务服务.造凭证(下一个凭证号(), 日期, 要素[0], 要素[1]))
    定义 词 = "盘盈"
    如果 差异金额 < 0 则
        词 = "盘亏"
    结束
    返回 [真, 词 + " " + 转文本(绝对值(差异数量)) + "，金额 "
        + 主数据.分转元(绝对值(差异金额))]
结束

请 盘点要素(物料编号, 差异金额)
    定义 摘要 = "盘点调整 / " + 物料编号
    定义 额 = 绝对值(差异金额)
    如果 差异金额 >= 0 则
        返回 [摘要, [
        财务服务.造分录("1001", 借贷方向.借, 额),
        财务服务.造分录("5901", 借贷方向.贷, 额)
        ]]
    结束
    返回 [摘要, [
    财务服务.造分录("5901", 借贷方向.借, 额),
    财务服务.造分录("1001", 借贷方向.贷, 额)
    ]]
结束

// ------------------------------------------------------------ 订单查找与替换（内部）
//
// 「查找」「替换」成对出现，且**都按单号取值** —— 单号是业务主键。
// 替换时整体替换列表元素，不做就地改字段（引用语义提醒，见文件头）。

请 找采购单(单号)
    遍历 采购订单表 中的每个 某订单
        如果 某订单.单号 是 单号 则
            返回 某订单
        结束
    结束
    返回 空
结束

请 替换采购单(单号, 新订单)
    定义 结果 = []
    遍历 采购订单表 中的每个 某订单
        如果 某订单.单号 是 单号 则
            入列(结果, 新订单)
        否则
            入列(结果, 某订单)
        结束
    结束
    采购订单表 = 结果
结束

请 找销售单(单号)
    遍历 销售订单表 中的每个 某订单
        如果 某订单.单号 是 单号 则
            返回 某订单
        结束
    结束
    返回 空
结束

请 替换销售单(单号, 新订单)
    定义 结果 = []
    遍历 销售订单表 中的每个 某订单
        如果 某订单.单号 是 单号 则
            入列(结果, 新订单)
        否则
            入列(结果, 某订单)
        结束
    结束
    销售订单表 = 结果
结束

// ------------------------------------------------------------ 开单与审核

请 开采购单(供应商编号, 日期, 明细)
    定义 号 = 下一个采购号()
    入列(采购订单表, 采购服务.造采购订单(号, 供应商编号, 日期, 明细))
    返回 号
结束

请 开销售单(客户编号, 日期, 明细)
    定义 号 = 下一个销售号()
    入列(销售订单表, 销售服务.造销售订单(号, 客户编号, 日期, 明细))
    返回 号
结束

// 审核单据。判据用「返回的订单是不是原对象」——
// 服务层的审核函数在失败时**原样返回入参**，成功时返回新对象。
// 这比在业务层再写一遍「状态是不是草稿、明细是不是为空」可靠：
// 审核规则的唯一实现留在 `采购服务` / `销售服务` 里，上层只解释结果。
请 审核采购(单号)
    定义 原订单 = 找采购单(单号)
    如果 原订单 是 空 则
        最近错误 = "找不到采购单「" + 单号 + "」"
        返回 [假, 最近错误]
    结束
    定义 结果 = 采购服务.审核采购单(原订单)
    如果 结果[0] 是 原订单 则
        最近错误 = 结果[1]
        返回 [假, 最近错误]
    结束
    替换采购单(单号, 结果[0])
    返回 [真, 结果[1]]
结束

请 审核销售(单号)
    定义 原订单 = 找销售单(单号)
    如果 原订单 是 空 则
        最近错误 = "找不到销售单「" + 单号 + "」"
        返回 [假, 最近错误]
    结束
    定义 结果 = 销售服务.审核销售单(原订单)
    如果 结果[0] 是 原订单 则
        最近错误 = 结果[1]
        返回 [假, 最近错误]
    结束
    替换销售单(单号, 结果[0])
    返回 [真, 结果[1]]
结束

// ------------------------------------------------------------ 状态读取（只读出口）
//
// 外部模块要读状态，一律经这些函数，不直接引用状态变量 ——
// 直接引用会让「谁改了状态」变得不可追踪。
//
// **注意返回的是引用**（不是拷贝）：报表只读不写，故这里不做深拷贝，
// 图个简单。若将来有人拿着返回值去改，就会**绕过 `入账` / `记流水`
// 唯二入口**污染状态 —— 所以约定：这些出口只许读，不许改。

请 取物料表()
    返回 物料表
结束

请 取单位表()
    返回 单位表
结束

请 取科目表()
    返回 科目表
结束

请 取库存台账()
    返回 库存台账
结束

请 取库存流水()
    返回 库存流水
结束

请 取采购订单表()
    返回 采购订单表
结束

请 取销售订单表()
    返回 销售订单表
结束

请 取账簿()
    返回 账簿
结束

请 取最近错误()
    返回 最近错误
结束