// 应收账款对账系统 —— 主程序
//
// 演示完整业务流程：建档 → 开单 → 信用检查 → 回款 → 账龄分析 → 报表导出。
// 数据全部内联构造，不依赖外部文件，便于直接运行验证。

引入 "领域模型"
引入 "账龄服务"
引入 "报表"

// 把「元」转成「分」（企业系统内部一律用整数分）
请 元(金额文本)
    返回 四舍五入(转小数(金额文本) * 100)
结束

输出("═══ 应收账款对账系统 · 演示 ═══")
输出("")

// ============================================================ 一、建立客户档案

定义 客户表 = [
    领域模型.造客户("C001", "中原食品有限公司", 领域模型.客户等级.战略客户,
        领域模型.默认信用额度(领域模型.客户等级.战略客户),
        领域模型.默认账期(领域模型.客户等级.战略客户)),
    领域模型.造客户("C002", "豫东商贸", 领域模型.客户等级.重要客户,
        领域模型.默认信用额度(领域模型.客户等级.重要客户),
        领域模型.默认账期(领域模型.客户等级.重要客户)),
    领域模型.造客户("C003", "小李经销部", 领域模型.客户等级.临时客户,
        领域模型.默认信用额度(领域模型.客户等级.临时客户),
        领域模型.默认账期(领域模型.客户等级.临时客户))
]

请 找客户(编号)
    遍历 客户表 中的每个 客
        如果 客.编号 是 编号 则
            返回 客
        结束
    结束
    抛出 "客户不存在：" + 编号
结束

输出("一、客户档案")
输出("  共 " + 转文本(长度(客户表)) + " 家客户")
遍历 客户表 中的每个 客
    输出("  " + 客.编号 + "  " + 客.名称
        + "  [信用额度 " + 报表.分转元文本(客.信用额度) + " 元]"
        + "  [账期 " + 转文本(客.账期天数) + " 天]")
结束
输出("")

// ============================================================ 二、开具应收单

定义 单据表 = []

请 开单(单号, 客户编号, 开票日期, 到期日期, 金额文本)
    定义 客 = 找客户(客户编号)
    定义 金额分 = 元(金额文本)
    定义 检查 = 账龄服务.检查信用(客, 单据表, 金额分)
    如果 非 检查[0] 则
        输出("  ✗ 开单失败 " + 单号 + "：" + 检查[1])
        返回 空
    结束
    定义 单 = 领域模型.造应收单(单号, 客户编号, 开票日期, 到期日期, 金额分)
    单.状态 = 领域模型.单据状态.已确认
    入列(单据表, 单)
    输出("  ✓ 开单成功 " + 单号 + "  " + 客.名称
        + "  " + 报表.分转元文本(金额分) + " 元")
    返回 单
结束

输出("二、开具应收单")
开单("AR2026001", "C001", "2026-06-01", "2026-08-30", "199905.00")
开单("AR2026002", "C001", "2026-07-15", "2026-10-13", "88500.00")
开单("AR2026003", "C002", "2026-05-10", "2026-06-24", "152300.50")
开单("AR2026004", "C002", "2026-08-01", "2026-09-15", "42300.00")
开单("AR2026005", "C003", "2026-09-01", "2026-10-01", "9800.00")
// 这一单应被信用额度拦下：临时客户额度 10 万，前面已有 9800，再加 9.5 万就超了
开单("AR2026006", "C003", "2026-09-20", "2026-10-20", "95000.00")
输出("")

// ============================================================ 三、登记回款

输出("三、登记回款")

请 收款(应收单号, 回款日期, 金额文本)
    定义 目标 = 空
    遍历 单据表 中的每个 单
        如果 单.单号 是 应收单号 则
            目标 = 单
            继续
        结束
    结束
    如果 目标 是 空 则
        输出("  ✗ 找不到单据 " + 应收单号)
        返回
    结束
    定义 结果 = 账龄服务.记回款(目标, 元(金额文本))
    如果 结果[0] 则
        输出("  ✓ " + 应收单号 + " 回款 " + 金额文本
            + " 元，状态 → " + 转文本(目标.状态))
    否则
        输出("  ✗ " + 应收单号 + "：" + 结果[1])
    结束
结束

收款("AR2026001", "2026-07-10", "100000.00")
收款("AR2026001", "2026-08-10", "99905.00")
收款("AR2026003", "2026-06-01", "50000.00")
// 这一笔应被拦下：超出未收余额
收款("AR2026004", "2026-08-20", "999999.00")
// 这一笔应被拦下：金额为 0
收款("AR2026005", "2026-09-15", "0.00")
输出("")

// ============================================================ 四、信用额度预警

输出("四、客户应收占用情况")
遍历 客户表 中的每个 客
    定义 占用 = 账龄服务.应收总额(单据表, 客.编号)
    定义 占比 = 0.0
    如果 客.信用额度 > 0 则
        占比 = 占用 * 100 / 客.信用额度
    结束
    定义 状态 = "正常"
    如果 占比 > 90.0 则
        状态 = "⚠ 逼近额度"
    结束
    如果 占比 > 100.0 则
        状态 = "⛔ 已超额"
    结束
    输出("  " + 客.名称 + "：占用 " + 报表.分转元文本(占用)
        + " / " + 报表.分转元文本(客.信用额度)
        + " 元（" + 转文本(四舍五入(占比)) + "%）" + 状态)
结束
输出("")

// ============================================================ 五、账龄分析报表

定义 基准日 = "2026-10-20"
输出(报表.渲染应收报表(单据表, 基准日))