// 应收账龄分析报表
//
// 企业报表的三个硬要求：
//   ① 金额显示成「元」（内部是分），带千分位；
//   ② 中文列名按**显示宽度**对齐（汉字算 2 列）；
//   ③ 汇总行与明细行同口径，数字右对齐。

引入 { 分档账龄, 区间名, 未收金额, 逾期天数 } 从 "账龄服务"
引入 "领域模型"
引入 "文本"

// ============================================================ 金额格式化

// 分 → 元（文本，保留两位小数）。例：199905 → "1999.05"
请 分转元文本(分)
    定义 负数 = 分 < 0
    定义 绝对值分 = 绝对值(分)
    定义 整数部分 = 取整(绝对值分 / 100)
    定义 小数部分 = 绝对值分 % 100
    定义 小数文本 = 转文本(小数部分)
    如果 长度(小数文本) 是 1 则
        小数文本 = "0" + 小数文本
    结束
    定义 结果 = 千分位(整数部分) + "." + 小数文本
    如果 负数 则
        返回 "-" + 结果
    结束
    返回 结果
结束

// 整数 → 千分位文本。例：1234567 → "1,234,567"
请 千分位(整数)
    定义 原文 = 转文本(整数)
    定义 符号 = ""
    定义 数字 = 原文
    如果 开头是(原文, "-") 则
        符号 = "-"
        数字 = 截取(原文, 1)
    结束
    定义 长度数 = 长度(数字)
    定义 结果 = ""
    定义 计数 = 0
    定义 下标 = 长度数 - 1
    当 下标 >= 0 成立
        定义 字符 = 截取(数字, 下标, 1)
        结果 = 字符 + 结果
        计数 = 计数 + 1
        如果 计数 % 3 是 0 且 下标 > 0 则
            结果 = "," + 结果
        结束
        下标 = 下标 - 1
    结束
    返回 符号 + 结果
结束

// ============================================================ 表格渲染

// 按显示宽度补空格（右对齐用于数字列）
//
// 注意：参数名**不能**叫 `文本` —— 那会把内置模块 `文本` 挡住，
// 函数体里的 `文本.填充` 取到的就成了这个参数（一个字符串）。
// 这类遮蔽由 `sy 检查` 的 W4001 提醒兜住。
请 左对齐(原文, 宽度)
    返回 文本.填充(原文, 宽度, " ", "左")
结束

请 右对齐(原文, 宽度)
    返回 文本.填充(原文, 宽度, " ", "右")
结束

// 渲染一条明细行
//
// 长表达式换行：**运算符放在上一行行尾**（枢言靠行尾运算符续行）。
// 行首运算符不会接续上一行，会被当成新语句（`sy 检查` 报 D2012）。
请 明细行(序号, 单, 基准日)
    定义 账龄 = 逾期天数(单, 基准日)
    定义 区间 = 区间名(分档账龄(账龄))
    定义 逾期文本 = 转文本(账龄)
    如果 账龄 < 0 则
        逾期文本 = "未到期"
    结束
    返回 右对齐(转文本(序号), 4) + "  " +
        左对齐(单.单号, 14) + "  " +
        左对齐(单.客户编号, 10) + "  " +
        右对齐(分转元文本(单.金额), 14) + "  " +
        右对齐(分转元文本(未收金额(单)), 14) + "  " +
        右对齐(逾期文本, 10) + "  " +
        左对齐(区间, 14)
结束

// 表头
请 表头()
    返回 右对齐("序号", 4) + "  " +
        左对齐("单号", 14) + "  " +
        左对齐("客户编号", 10) + "  " +
        右对齐("开票金额元", 14) + "  " +
        右对齐("未收金额元", 14) + "  " +
        右对齐("逾期天数", 10) + "  " +
        左对齐("账龄区间", 14)
结束

// 分隔线
请 分隔线()
    返回 复制("-", 90)
结束

// ============================================================ 账龄汇总表

// 按账龄区间汇总：返回 [区间, 单数, 未收金额分] 的列表
请 账龄汇总(全部单据, 基准日)
    定义 桶 = {}
    定义 顺序 = []
    遍历 全部单据 中的每个 单
        如果 单.状态 是 领域模型.单据状态.已作废 则
            继续
        结束
        定义 账龄 = 逾期天数(单, 基准日)
        定义 名 = 区间名(分档账龄(账龄))
        如果 非 有键(桶, 名) 则
            桶[名] = [0, 0]
            入列(顺序, 名)
        结束
        桶[名][0] = 桶[名][0] + 1
        桶[名][1] = 桶[名][1] + 未收金额(单)
    结束
    定义 行 = []
    遍历 顺序 中的每个 名
        入列(行, [名, 桶[名][0], 桶[名][1]])
    结束
    返回 行
结束

// 渲染账龄汇总表
请 渲染账龄汇总(全部单据, 基准日)
    定义 汇总 = 账龄汇总(全部单据, 基准日)
    定义 行 = []
    入列(行, 左对齐("账龄区间", 16) + "  " +
        右对齐("单数", 8) + "  " + 右对齐("未收金额元", 16))
    入列(行, 复制("-", 46))
    定义 总单数 = 0
    定义 总金额 = 0
    遍历 汇总 中的每个 项
        入列(行, 左对齐(项[0], 16) + "  " +
            右对齐(转文本(项[1]), 8) + "  " +
            右对齐(分转元文本(项[2]), 16))
        总单数 = 总单数 + 项[1]
        总金额 = 总金额 + 项[2]
    结束
    入列(行, 复制("-", 46))
    入列(行, 左对齐("合计", 16) + "  " +
        右对齐(转文本(总单数), 8) + "  " +
        右对齐(分转元文本(总金额), 16))
    返回 连接(行, "\n")
结束

// ============================================================ 完整报表

请 渲染应收报表(全部单据, 基准日)
    定义 行 = []
    入列(行, "应收对账与账龄分析报表")
    入列(行, "基准日：" + 基准日)
    入列(行, 分隔线())
    入列(行, 表头())
    入列(行, 分隔线())
    定义 序号 = 0
    定义 合计金额 = 0
    定义 合计未收 = 0
    遍历 全部单据 中的每个 单
        如果 单.状态 是 领域模型.单据状态.已作废 则
            继续
        结束
        序号 = 序号 + 1
        入列(行, 明细行(序号, 单, 基准日))
        合计金额 = 合计金额 + 单.金额
        合计未收 = 合计未收 + 未收金额(单)
    结束
    入列(行, 分隔线())
    入列(行, 右对齐("合计", 4) + "  " +
        左对齐("", 14) + "  " +
        左对齐("", 10) + "  " +
        右对齐(分转元文本(合计金额), 14) + "  " +
        右对齐(分转元文本(合计未收), 14))
    入列(行, "")
    入列(行, "账龄汇总")
    入列(行, 渲染账龄汇总(全部单据, 基准日))
    返回 连接(行, "\n")
结束